#!/usr/bin/env python3
"""APK内のnative版情報・ABI・ELF依存・hashを検査する。端末実行は別判定。"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import struct
import tempfile
import zipfile

from native_build import ABI, API, NDK, ROOT, TARGET, canonical


def note_bytes(dump):
    return b"".join(bytes.fromhex(word) for line in dump.splitlines() if re.match(r"\s*0x[0-9a-f]+\s", line)
                    for word in line.split()[1:5] if re.fullmatch(r"[0-9a-fA-F]{8}", word))


def inspect(apk):
    sdk = Path(os.environ.get("ANDROID_HOME", "/opt/android-sdk"))
    readelf = sdk / "ndk" / NDK / "toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-readelf"
    with zipfile.ZipFile(apk) as archive:
        names = archive.namelist()
        libpath = f"lib/{ABI}/libeidolon_native.so"
        if names.count(libpath) != 1 or names.count("assets/native-build.json") != 1:
            raise ValueError("製品nativeまたは版情報が欠落・重複しています")
        if any(name.endswith("/libeidolon_native.so") and name != libpath for name in names):
            raise ValueError("想定外ABIの製品nativeがあります")
        metadata = json.loads(archive.read("assets/native-build.json"))
        info = metadata["build_info"]
        fixture = metadata.get("remote_fixture")
        if info["profile"] == "debug":
            if (not isinstance(fixture, dict) or fixture.get("schema") != 1
                    or fixture.get("abi") != ABI or fixture.get("api") != API or fixture.get("ndk") != NDK
                    or fixture.get("fixture_revision") != "eidolon-shm-client-v1"
                    or fixture.get("build_info", {}).get("source_digest") != info["source_digest"]
                    or fixture.get("build_info", {}).get("profile") != "release"
                    or not re.fullmatch(r"[0-9a-f]{64}", fixture.get("sha256", ""))
                    or set(fixture.get("needed", [])) - {"libc.so", "libm.so", "libdl.so"}):
                raise ValueError("remote fixtureのsource/ABI/API/hashが不一致です")
        elif fixture is not None:
            raise ValueError("releaseにremote fixture情報が混入しています")
        if (metadata["abi"], metadata["api"], metadata["ndk"], info["target"], info["schema"]) != (ABI, API, NDK, TARGET, 1):
            raise ValueError("ABI/API/NDK/target/schemaが不一致です")
        data = archive.read(libpath)
        if hashlib.sha256(data).hexdigest() != metadata["files"]["libeidolon_native.so"]:
            raise ValueError("APK内soと生成metadataのhashが不一致です")
        if canonical(info).encode() not in data:
            raise ValueError("APK内soに期待した版情報がありません")
        dependency_file = ROOT / "native/deps.lock.json"
        locked = json.loads(dependency_file.read_text())
        dependencies = metadata.get("dependencies", {})
        licenses = {locked[key]["license_file"]: hashlib.sha256((ROOT / "native" / locked[key]["license_file"]).read_bytes()).hexdigest()
                    for key in ("libxkbcommon", "xkeyboard-config", "smithay", "waypipe", "lz4", "zstd")}
        if (dependencies.get("lock_sha256") != hashlib.sha256(dependency_file.read_bytes()).hexdigest()
                or dependencies.get("smithay") != locked["smithay"]
                or dependencies.get("keymaps") != locked["xkeyboard-config"]["keymaps"]
                or dependencies.get("licenses") != licenses
                or not re.fullmatch(r"[0-9a-f]{64}", dependencies.get("xkbcommon_static_sha256", ""))):
            raise ValueError("native dependencyの固定source情報が不一致です")
        for name, entry in dependencies["keymaps"].items():
            path = "assets/keymaps/" + name + ".xkb"
            if names.count(path) != 1:
                raise ValueError("keymap assetが欠落・重複しています")
            keymap = archive.read(path)
            if len(keymap) != entry["bytes"] or hashlib.sha256(keymap).hexdigest() != entry["sha256"]:
                raise ValueError("keymap hashが不一致です")
        for name, expected_hash in licenses.items():
            path = "assets/" + name
            if names.count(path) != 1 or hashlib.sha256(archive.read(path)).hexdigest() != expected_hash:
                raise ValueError("native license assetが欠落・不一致です")
        with tempfile.TemporaryDirectory(prefix="eidolon-elf-") as folder:
            elf = Path(folder) / "lib.so"
            elf.write_bytes(data)
            output = subprocess.check_output([str(readelf), "-h", "-d", "--dyn-syms", "--wide", str(elf)], text=True)
            note_dump = subprocess.check_output([str(readelf), "--hex-dump=.note.android.ident", str(elf)], text=True)
        note = bytearray()
        for line in note_dump.splitlines():
            if re.match(r"\s*0x[0-9a-f]+\s", line):
                for word in line.split()[1:5]:
                    if re.fullmatch(r"[0-9a-fA-F]{8}", word):
                        note.extend(bytes.fromhex(word))
        # NDK linkerが付けたnoteで実際のAPI/buildも確認する。自己申告metadataだけに依存しない。
        if len(note) < 24:
            raise ValueError("Android ELF noteがありません")
        name_size, description_size, note_type = struct.unpack_from("<III", note)
        descriptor = 12 + ((name_size + 3) // 4) * 4
        if (note[12:12 + name_size] != b"Android\0" or note_type != 1
                or description_size < 132 or len(note) < descriptor + description_size):
            raise ValueError("Android ELF noteが不正です")
        actual_api = struct.unpack_from("<I", note, descriptor)[0]
        actual_ndk_build = bytes(note[descriptor + 68:descriptor + 132]).split(b"\0", 1)[0].decode("ascii")
        if actual_api != API or actual_ndk_build != NDK.split(".")[-1]:
            raise ValueError("ELFの実際のAPI/NDK buildが不一致です")
        if not re.search(r"Machine:\s+AArch64", output):
            raise ValueError("製品nativeがAArch64ではありません")
        required = re.findall(r"\(NEEDED\).*\[([^]]+)\]", output)
        public = {"libc.so", "libm.so", "libdl.so", "liblog.so", "libandroid.so", "libEGL.so", "libGLESv3.so"}
        if set(required) - public:
            raise ValueError(f"許可されていないELF依存: {sorted(set(required) - public)}")
        waypipe = dependencies.get("waypipe", {})
        waypipe_path = f"lib/{ABI}/libwaypipe_bin.so"
        if [name for name in names if name.endswith("/libwaypipe_bin.so")] != [waypipe_path]:
            raise ValueError("WaypipeのABI/数が不正です")
        executable = archive.read(waypipe_path)
        actual_hash = hashlib.sha256(executable).hexdigest()
        inputs = {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest()
                  for name in ("native/deps.lock.json", "scripts/build-waypipe", "scripts/waypipe_build.py")}
        if (waypipe.get("source") != {name: locked[name] for name in ("waypipe", "lz4", "zstd")}
                or waypipe.get("sha256") != actual_hash or metadata["files"].get("libwaypipe_bin.so") != actual_hash
                or waypipe.get("inputs") != inputs):
            raise ValueError("Waypipeの固定source/build/hashが不一致です")
        for name in ("lz4", "zstd"):
            if not re.fullmatch(r"[0-9a-f]{64}", waypipe.get("libraries", {}).get(name, {}).get("sha256", "")):
                raise ValueError("Waypipeのstatic依存情報が不正です")
        with tempfile.TemporaryDirectory(prefix="eidolon-waypipe-elf-") as folder:
            elf = Path(folder) / "waypipe"
            elf.write_bytes(executable)
            header = subprocess.check_output([str(readelf), "-h", "-d", "-l", "--wide", str(elf)], text=True)
            actual_note = subprocess.check_output([str(readelf), "--hex-dump=.note.android.ident", str(elf)], text=True)
        needed = re.findall(r"\(NEEDED\).*\[([^]]+)\]", header)
        if (not re.search(r"Machine:\s+AArch64", header) or not re.search(r"Type:\s+DYN", header)
                or "/system/bin/linker64" not in header or set(needed) - {"libc.so", "libm.so", "libdl.so"}
                or waypipe.get("needed") != needed or note_bytes(actual_note) != bytes(note)):
            raise ValueError("Waypipeの実際のABI/API/NDK/loader/依存が不正です")
        for method in ("nativeBuildInfo", "nativeCreate", "nativeCommand", "nativeAttachSurface", "nativeAttachWindowSurface", "nativePoll", "nativeSnapshot", "nativeRequestStop", "nativeDestroy", "nativeGenerateIdentity", "nativePublicKey", "nativeProvideCredential"):
            if "Java_io_github_tinmachine_eidolon_NativeBridge_" + method not in output:
                raise ValueError("JNI symbolがありません: " + method)
        if (b"eidolon-local-shm-fixture-code-v1" in data) != (info["profile"] == "debug"):
            raise ValueError("profileとSHM fixtureの同梱が不一致です")
        if (b"eidolon-wayland-state-v1" in data) != (info["profile"] == "debug"):
            raise ValueError("profileとWayland state fixtureの同梱が不一致です")
        if (b"eidolon-render-fixture-code-v1" in data) != (info["profile"] == "debug"):
            raise ValueError("profileとrender fixtureの同梱が不一致です")
        helper_path = f"lib/{ABI}/libeidolon_probe_bin.so"
        helper_files = [name for name in names if name.endswith("/libeidolon_probe_bin.so")]
        if info["profile"] == "release" and helper_files:
            raise ValueError("releaseにhelper fixtureが混入しています")
        if info["profile"] == "debug":
            if helper_files != [helper_path]:
                raise ValueError("helper fixtureのABI/数が不正です")
            helper = archive.read(helper_path)
            if hashlib.sha256(helper).hexdigest() != metadata["files"].get("libeidolon_probe_bin.so"):
                raise ValueError("helper fixtureのhashが不一致です")
            with tempfile.TemporaryDirectory(prefix="eidolon-helper-elf-") as folder:
                elf = Path(folder) / "helper"
                elf.write_bytes(helper)
                header = subprocess.check_output([str(readelf), "-h", "-d", "-l", "--wide", str(elf)], text=True)
                actual_note = subprocess.check_output([str(readelf), "--hex-dump=.note.android.ident", str(elf)], text=True)
            if not re.search(r"Machine:\s+AArch64", header) or not re.search(r"Type:\s+DYN", header) or "/system/bin/linker64" not in header:
                raise ValueError("helper fixtureがAndroid AArch64 PIEではありません")
            if set(re.findall(r"\(NEEDED\).*\[([^]]+)\]", header)) - public:
                raise ValueError("helper fixtureに公開NDK外の依存があります")
            # 同じNDK/APIでbuildしたlibraryとnote内容が一致する。
            if note_bytes(actual_note) != bytes(note):
                raise ValueError("helper fixtureの実API/NDK noteが不一致です")
        debug_symbol = "Java_io_github_tinmachine_eidolon_DebugNativeBridge_" in output
        dex = b"".join(archive.read(name) for name in names if re.fullmatch(r"classes\d*\.dex", name))
        debug_classes = [b"Lio/github/tinmachine/eidolon/DebugCommandActivity;", b"Lio/github/tinmachine/eidolon/DebugNativeBridge;", b"Lio/github/tinmachine/eidolon/CredentialCase;", b"Lio/github/tinmachine/eidolon/SshCase;", b"Lio/github/tinmachine/eidolon/ProductSshCase;", b"Lio/github/tinmachine/eidolon/ForwardCase;", b"Lio/github/tinmachine/eidolon/RemoteCleanupCase;", b"Lio/github/tinmachine/eidolon/NativeCheckInstrumentation;", b"Lio/github/tinmachine/eidolon/NativeDepsCase;", b"Lio/github/tinmachine/eidolon/CompositorCase;"]
        debug_classes.append(b"Lio/github/tinmachine/eidolon/WaypipeCase;")
        debug_classes.append(b"Lio/github/tinmachine/eidolon/ForwardedShmCase;")
        debug_classes.append(b"Lio/github/tinmachine/eidolon/RenderCase;")
        debug_classes.append(b"Lio/github/tinmachine/eidolon/FootCase;")
        debug_classes.append(b"Lio/github/tinmachine/eidolon/FootSdkCase;")
        debug_dex = any(name in dex for name in debug_classes)
        if info["profile"] == "release" and (debug_symbol or debug_dex):
            raise ValueError("releaseにdebug JNI/classが混入しています")
        if info["profile"] == "release" and any(marker in dex for marker in (b"credential-fixtures", b"eidolon.fixture.")):
            raise ValueError("releaseにcredential fixtureが混入しています")
        if info["profile"] == "debug" and (not debug_symbol or not all(name in dex for name in debug_classes)):
            raise ValueError("debugの固定case JNI/classがありません")
    badging = subprocess.check_output([str(sdk / "build-tools/35.0.0/aapt"), "dump", "badging", str(apk)], text=True)
    version = re.search(r"package: name='io.github.tinmachine.eidolon' versionCode='(\d+)'", badging)
    min_sdk = re.search(r"sdkVersion:'(\d+)'", badging)
    if not version or int(version[1]) != info["apk_version_code"] or not min_sdk or int(min_sdk[1]) != API:
        raise ValueError("APK manifestの版/APIとnative版情報が不一致です")
    manifest = subprocess.check_output([str(sdk / "build-tools/35.0.0/aapt"), "dump", "xmltree", str(apk), "AndroidManifest.xml"], text=True)
    if ("DebugCommandActivity" in manifest) != (info["profile"] == "debug"):
        raise ValueError("profileとdebug manifest入口が不一致です")
    if ("NativeCheckInstrumentation" in manifest) != (info["profile"] == "debug"):
        raise ValueError("profileとinstrumentation manifest入口が不一致です")
    return {**metadata, "needed": required, "debug_entry": info["profile"] == "debug", "status": "pass"}


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apk", type=Path, required=True)
    args = parser.parse_args()
    print(json.dumps(inspect(args.apk), indent=2))
