#!/usr/bin/env python3
"""配備済み固定Freedoom demo128を一回実行し、同jobでSDK全資源退役を照合する。"""
import argparse
import datetime
import json
import os
from pathlib import Path
import re
import secrets
import selectors
import shlex
import subprocess
import time
import freedoom_probe_host as host
from gui_probe_sdk import digest_sources
from quest_device import PACKAGE,QuestDevice,package_uid,work_root
from sdl_lease_capture import CaptureError,MAX_SNAPSHOT,binding_key,canonical,decode,hexadecimal,need,select_snapshot


def safe_reason(error,default="OPERATOR_UNAVAILABLE"):
    value=error.reason if isinstance(error,CaptureError) else default
    return value if type(value) is str and re.fullmatch(r"[A-Z][A-Z0-9_]{0,79}",value) else default


def request_cancel(child):
    if child.stdin is None or child.stdin.closed:return False
    try:child.stdin.write(b'{"type":"cancel"}\n');child.stdin.flush();return True
    except (OSError,ValueError):return False


def close_control(child):
    if child.stdin is not None and not child.stdin.closed:
        try:child.stdin.close()
        except (OSError,ValueError):pass


def transport(command,request,poll,retired,*,timeout=42,tail=8):
    """実spawnしたADB handleだけを所有。remoteの自発cleanup証拠は別に保持する。"""
    receiver=host.Events(request);selector=selectors.DefaultSelector();pending=bytearray();sizes=dict(stdout=0,stderr=0)
    child=subprocess.Popen(command,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    result=dict(remote_returncode=None,host_reaped=False,host_pipes_drained=False,timed_out=False,monitor_failure=None,transport_failure=None)
    ended=None;cancelled=False;started=time.monotonic();last_poll=0
    def cancel():
        nonlocal cancelled
        if not cancelled:cancelled=request_cancel(child)
    def read(wait):
        nonlocal ended
        for key,_ in selector.select(wait):
            try:data=os.read(key.fd,8192)
            except BlockingIOError:continue
            if not data:selector.unregister(key.fd);continue
            sizes[key.data]+=len(data)
            need(sizes[key.data]<=65536,"REMOTE_OUTPUT_LIMIT")
            if key.data=="stderr":continue
            pending.extend(data);need(len(pending)<=16384,"REMOTE_OUTPUT_LIMIT")
            while b"\n" in pending:
                line,_,rest=pending.partition(b"\n");pending[:]=rest
                receiver.receive(decode(line,16384))
                if receiver.finished is not None or receiver.blocked is not None:ended=ended or time.monotonic()
    try:
        for name in ("stdout","stderr"):
            pipe=getattr(child,name);os.set_blocking(pipe.fileno(),False);selector.register(pipe,selectors.EVENT_READ,name)
        try:child.stdin.write(canonical(request)+b"\n");child.stdin.flush()
        except (OSError,ValueError):pass  # 早期拒否はstdout/元RCを先に回収する。
        while time.monotonic()-started<timeout:
            now=time.monotonic()
            if now-last_poll>=.1:
                last_poll=now
                try:poll()
                except (OSError,ValueError,TypeError,KeyError,subprocess.SubprocessError) as error:
                    result["monitor_failure"]=safe_reason(error,"SDK_MONITOR_UNAVAILABLE");cancel()
            read(.02)
            if ended is not None and now-ended>=1 and (retired() or now-ended>=tail) and child.poll() is not None and not selector.get_map():break
            if child.poll() is not None and not selector.get_map() and ended is None:break
        else:result["timed_out"]=True;cancel()
    except (OSError,ValueError,TypeError,KeyError,subprocess.SubprocessError) as error:
        result["transport_failure"]=safe_reason(error);cancel()
    finally:
        # 取消後も固定JSONだけを読み、remoteのowned-group回収結果を失わない。
        until=time.monotonic()+8
        if child.poll() is None and ended is None:cancel()
        while selector.get_map() and time.monotonic()<until:
            try:read(.03)
            except (OSError,ValueError,TypeError,KeyError) as error:
                result["transport_failure"]=result["transport_failure"] or safe_reason(error);cancel();break
        close_control(child)
        try:child.wait(timeout=3);result["host_reaped"]=True
        except subprocess.TimeoutExpired:
            result["transport_failure"]=result["transport_failure"] or "REMOTE_CLEANUP_UNCONFIRMED"
            child.terminate()  # 自分のADBだけ。観測foot/shell/PIDへsignalしない。
            try:child.wait(timeout=2);result["host_reaped"]=True
            except subprocess.TimeoutExpired:
                child.kill();child.wait(timeout=2);result["host_reaped"]=True
        result["host_pipes_drained"]=not selector.get_map() and not pending
        selector.close();child.stdout.close();child.stderr.close()
    result.update(remote_returncode=child.returncode,remote_result=receiver.finished,blocked_reason=receiver.blocked,events=receiver.events,output_bytes=sizes,cancel_sent=cancelled)
    return result


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--serial",required=True);parser.add_argument("--asset-run-id",required=True)
    parser.add_argument("--manifest-sha256",required=True);parser.add_argument("--engine-sha256",required=True)
    parser.add_argument("--artifact-root",type=Path)
    args=parser.parse_args()
    if not hexadecimal(args.asset_run_id,32) or not hexadecimal(args.manifest_sha256,64) or args.engine_sha256!=host.game.assets.ENGINE_SHA:
        parser.error("asset run-idは32hex、manifestは既知64hex、engineは固定3.1.1の期待SHAです")
    os.umask(0o077);probe_id=secrets.token_hex(16)
    root=args.artifact_root or work_root()/"eidolon-freedoom-demo128"
    if not root.is_absolute():parser.error("artifact rootは絶対pathです")
    run=root/(datetime.datetime.now().strftime("%Y%m%dT%H%M%S-%f")+"-"+probe_id);run.mkdir(mode=0o700,parents=True)
    result=dict(schema=1,status="blocked",operator=host.game.OPERATOR,case=host.game.CASE,probe_id=probe_id,asset_run_id=args.asset_run_id,
        manifest_sha256=args.manifest_sha256,engine_sha256=args.engine_sha256,physical_input="not_run",hmd="not_run",catalog="not_modified",sdk_samples=[])
    device=QuestDevice(args.serial,run)
    def snapshot():
        row=subprocess.run(["adb","-s",args.serial,"exec-out","run-as",PACKAGE,"head","-c",str(MAX_SNAPSHOT+1),"no_backup/diagnostics/latest.json"],capture_output=True,timeout=5)
        need(row.returncode==0,"DIAGNOSTICS_UNAVAILABLE");return decode(row.stdout)
    try:
        result["device"]=device.validate()
        uid=package_uid(device.adb("shell","pm","list","packages","-U","com.termux"),"com.termux");need(uid==host.game.UID,"UID_MISMATCH")
        source=host.source_hashes();digest=digest_sources();initial=snapshot();binding=select_snapshot(initial,digest,uid)
        need(device.adb("shell","pidof",PACKAGE).strip()==str(binding["process_id"]),"APK_PROCESS_NOT_CURRENT")
        baseline=host.sdk.sdk_sample(initial);need(len(baseline["mapped"])==1,"ONE_BASELINE_WINDOW_REQUIRED")
        request=dict(schema=1,probe_id=probe_id,asset_run_id=args.asset_run_id,manifest_sha256=args.manifest_sha256,engine_sha256=args.engine_sha256,binding=binding)
        result.update(binding=binding,operator_source_sha256=source,source_digest=digest,sdk_baseline=baseline,
            graphics_environment=host.game.assets.source.launch_plan(args.asset_run_id)["graphics_environment"],app_id=host.game.app_id(probe_id))
        (run/"request.json").write_bytes(canonical(request)+b"\n")
        command_text=shlex.join(host.remote_command());result["remote_command_bytes"]=len(command_text.encode())
        def poll():
            value=snapshot();need(binding_key(select_snapshot(value,digest,uid))==binding_key(binding),"APK_BINDING_CHANGED")
            sample=host.sdk_sample(value,probe_id,baseline["mapped"])
            if not result["sdk_samples"] or result["sdk_samples"][-1]["sequence"]!=sample["sequence"]:
                need(len(result["sdk_samples"])<512,"SDK_SAMPLE_LIMIT");result["sdk_samples"].append(sample)
        result.update(transport(["adb","-s",args.serial,"shell","-T",command_text],request,poll,
            lambda:host.sdk.sdk_resources_retired(baseline,result["sdk_samples"])))
        result["sdk_observation"]=host.summarize_sdk(baseline,result["sdk_samples"])
        result["source_unchanged"]=source==host.source_hashes() and digest==digest_sources()
        remote=result["remote_result"]
        passed=(remote is not None and remote["status"]=="completed" and result["remote_returncode"]==0 and result["host_reaped"] and result["host_pipes_drained"] and
            not result["monitor_failure"] and not result["transport_failure"] and not result["timed_out"] and result["source_unchanged"] and result["sdk_observation"]["status"]=="observed")
        result["status"]="completed" if passed else "blocked" if result["blocked_reason"] and not result["events"] else "failed"
    except (OSError,ValueError,TypeError,KeyError,subprocess.SubprocessError,RuntimeError) as error:
        result.update(status="failed" if "remote_returncode" in result else "blocked",reason=safe_reason(error))
    finally:(run/"result.json").write_text(json.dumps(result,indent=2)+"\n")
    print(json.dumps(dict(status=result["status"],artifact=str(run),probe_id=probe_id,case=host.game.CASE,reason=result.get("reason") or result.get("blocked_reason"),
        sdk_observation=result.get("sdk_observation",{}).get("status"),physical_input="not_run",hmd="not_run")))
    return 0 if result["status"]=="completed" else 1


if __name__=="__main__":raise SystemExit(main())
