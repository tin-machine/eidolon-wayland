#!/usr/bin/env python3
"""hostで完結するsuiteを実行する。実機・未実装suiteを成功にしない。"""
import argparse
import json
import os
import re
from pathlib import Path
import subprocess
import sys
import unittest

from host_checks import check_members, rust_test_count

ROOT = Path(__file__).resolve().parents[1]
SUITES = {"model": ["eidolon-model"], "render": ["eidolon-render"], "lifecycle": ["eidolon-core", "eidolon-android", "eidolon-helper-fixture"],
          "transport": ["eidolon-transport"], "compositor": ["eidolon-core", "eidolon-shm-fixture"], "input": ["eidolon-model"]}
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--suite", required=True, choices=[*SUITES, "all"])
args = parser.parse_args()
if args.suite != "all" and not SUITES[args.suite]:
    print(json.dumps({"suite": args.suite, "result": "not_run", "reason": "未実装"}, ensure_ascii=False))
    raise SystemExit(2)


def run(command):
    print("+ " + " ".join(command), flush=True)
    result = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    print(result.stdout, end="", flush=True)
    if result.returncode:
        raise subprocess.CalledProcessError(result.returncode, command)
    return result.stdout


def python_tests(directory):
    suite = unittest.TestLoader().discover(str(directory))
    result = unittest.TextTestRunner(verbosity=2).run(suite)
    if not result.wasSuccessful() or result.testsRun - len(result.skipped) < 1:
        raise RuntimeError("Python test失敗、または実行対象が0件です")
    print(json.dumps({"python": str(directory.relative_to(ROOT)), "run": result.testsRun - len(result.skipped), "skipped": len(result.skipped)}))


def renderer_static_link():
    output = subprocess.check_output(["cargo", "test", "--locked", "-p", "eidolon-render", "--no-run", "--message-format=json"], cwd=ROOT, text=True)
    artifacts = [json.loads(line) for line in output.splitlines()]
    executable = next(item["executable"] for item in artifacts
                      if item.get("reason") == "compiler-artifact" and item["target"]["name"] == "eidolon_render"
                      and item["profile"]["test"] and item.get("executable"))
    elf = subprocess.check_output(["readelf", "-d", executable], text=True)
    needed = re.findall(r"\(NEEDED\).*\[([^]]+)\]", elf)
    if any("xkbcommon" in library for library in needed):
        raise RuntimeError("render testがsystem libxkbcommonへ動的依存しています")
    print(json.dumps({"suite": "render-static-link", "result": "pass", "needed": needed}))


try:
    if args.suite == "all":
        run([os.environ.get("EIDOLON_TEST_SSHD", "/usr/sbin/sshd"), "-V"])
        run(["python3", "scripts/check-design"])
        run(["python3", "scripts/check-build-tools"])
        run(["python3", "scripts/build-native-deps", "--target", "host"])
        run(["python3", "scripts/build-waypipe", "--target", "host"])
        run(["cargo", "build", "--locked", "-p", "eidolon-shm-fixture", "--bin", "eidolon-shm-fixture"])
        run(["python3", "scripts/check-native-deps"])
        run(["cargo", "fmt", "--all", "--check"])
        run(["cargo", "clippy", "--locked", "--workspace", "--all-targets", "--", "-D", "warnings"])
        metadata = json.loads(subprocess.check_output(["cargo", "metadata", "--locked", "--no-deps", "--format-version=1"], cwd=ROOT, text=True))
        members = [p["name"] for p in metadata["packages"] if p["id"] in metadata["workspace_members"]]
        check_members(members, [p for group in SUITES.values() for p in group])
    if args.suite in {"render", "lifecycle", "compositor"}:
        run(["python3", "scripts/build-native-deps", "--target", "host"])
    if args.suite in {"lifecycle", "compositor"}:
        run(["python3", "scripts/build-waypipe", "--target", "host"])
        run(["cargo", "build", "--locked", "-p", "eidolon-shm-fixture", "--bin", "eidolon-shm-fixture"])
    for name, packages in SUITES.items():
        if args.suite not in {"all", name}:
            continue
        if not packages:
            print(json.dumps({"suite": name, "result": "not_run", "reason": "未実装"}, ensure_ascii=False))
            continue
        if args.suite == "all" and name == "input":
            print(json.dumps({"suite": name, "result": "included", "in": "model"}))
            continue
        count = 0
        for package in packages:
            # core内のcompositor testは独立suiteでも使う。allではlifecycle側で一度だけ実行する。
            if args.suite == "all" and name == "compositor" and package == "eidolon-core":
                print(json.dumps({"suite": name, "result": "included", "in": "lifecycle"}))
                continue
            command = ["cargo", "test", "--locked", "-p", package]
            if name == "compositor" and package == "eidolon-core":
                command.append("compositor::")
            if name == "input":
                command.append("input::")
            count += rust_test_count(run(command))
        if count < 1:
            raise RuntimeError("実行testが0件のsuiteを成功にしません")
        print(json.dumps({"suite": name, "result": "pass", "tests": count}))
        if name == "render":
            renderer_static_link()
    if args.suite == "all":
        python_tests(ROOT / "scripts/tests")
        launcher = ROOT / "scripts/termux/tests"
        if launcher.is_dir():
            python_tests(launcher)
        else:
            print('{"suite":"launcher","result":"not_run","reason":"T03で追加する"}')
except (ValueError, RuntimeError, subprocess.CalledProcessError) as error:
    print(f"host検証失敗: {error}", file=sys.stderr)
    raise SystemExit(1)
