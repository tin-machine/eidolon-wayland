#!/usr/bin/env python3
"""Summarize one Eidolon task-clock:u recording using the Android NDK's Simpleperf library."""
import argparse
import json
from collections import Counter
from pathlib import Path

FRAME = "com.meta.spatial.runtime.FramePhaseController.onFrame"
SDK = "com.meta.spatial."
APP = "io.github.tinmachine.eidolon."


def category(stack):
    if FRAME in stack:
        callees = stack[:stack.index(FRAME)]
        if any(name.startswith(APP) for name in callees):
            return "frame/Eidolon callback"
        for name in callees:
            if name.startswith(SDK) and name.endswith(".execute") and not name.endswith(".SystemManager.execute"):
                return "frame/" + name.rsplit(".", 2)[-2]
        return "frame/other"
    for owner in ("SpatialLauncher", "SpatialPanelAdapter", "PhysicalMouse", "QuestStatusHud"):
        if any(name.startswith(APP + owner) for name in stack):
            return "outside/" + owner
    return "outside/other main"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("record", type=Path, help="perf.data captured with -app and -g")
    args = parser.parse_args()
    try:
        from simpleperf_report_lib import ReportLib
    except ImportError:
        parser.exit(2, "Set PYTHONPATH to the Android NDK simpleperf directory.\n")
    lib = ReportLib()
    periods = Counter()
    process = None
    samples = 0
    try:
        lib.SetRecordFile(str(args.record))
        while (sample := lib.GetNextSample()) is not None:
            if lib.GetEventOfCurrentSample().name != "task-clock:u":
                parser.error("expected task-clock:u")
            if process is not None and process != sample.pid:
                parser.error("capture a single Eidolon process")
            process = sample.pid
            name = "other threads"
            if sample.tid == sample.pid:
                chain = lib.GetCallChainOfCurrentSample()
                stack = [lib.GetSymbolOfCurrentSample().symbol_name]
                stack.extend(chain.entries[i].symbol.symbol_name for i in range(chain.nr))
                name = category(stack)
            periods[name] += sample.period
            samples += 1
    finally:
        lib.Close()
    total = sum(periods.values())
    frame = sum(v for k, v in periods.items() if k.startswith("frame/"))
    if not total or not frame:
        parser.error("no SDK frame found; check the app, XR focus, call graphs and symbols")
    print(json.dumps({
        "samples": samples, "task_clock_ns": total, "frame_percent": round(100 * frame / total, 3),
        "percent_of_process": {k: round(100 * v / total, 3) for k, v in periods.most_common()},
    }, indent=2))


if __name__ == "__main__":
    main()
