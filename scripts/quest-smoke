#!/usr/bin/env python3
"""指定QuestへAPKを更新し、起動・scene/panel生成・ログを採取する。HMD目視は別判定。"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import time

PACKAGE = "io.github.tinmachine.eidolon"
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--serial", required=True, help="adb devicesに出るUSB serialまたはIP:port")
parser.add_argument("--apk", required=True, type=Path)
parser.add_argument("--artifact-root", type=Path)
parser.add_argument("--timeout", type=int, default=45)
parser.add_argument("--require-focus", action="store_true", help="HMD装着によるXR FOCUSEDまで待つ")
args = parser.parse_args()
os.umask(0o077)
config = Path.home() / ".config/homecluster-agents/codex-work-root"
work_root = Path(config.read_text().strip()) if config.exists() else Path.home() / ".local/state/homecluster-agents/codex-work"
root = args.artifact_root or work_root / "eidolon-phase0/smoke"
if not root.is_absolute():
    parser.error("artifact rootには絶対pathが必要です")
run = root / (datetime.datetime.now().strftime("%Y%m%dT%H%M%S") + f"-{os.getpid()}")
run.mkdir(parents=True, mode=0o700)
if not args.apk.is_file():
    parser.error("APKがありません")
print(f"Artifacts: {run}", flush=True)

def adb(*command, timeout=30):
    with (run / "commands.log").open("a") as log:
        log.write(json.dumps(["adb", "-s", "[ADB_TARGET]", *command], ensure_ascii=False) + "\n")
    result = subprocess.run(["adb", "-s", args.serial, *command], text=True, capture_output=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError(f"{command}: {result.stdout}\n{result.stderr}")
    return result.stdout

sdk = Path(os.environ.get("ANDROID_HOME", "/opt/android-sdk"))
badging = subprocess.check_output([str(sdk / "build-tools/35.0.0/aapt"), "dump", "badging", str(args.apk)], text=True)
manifest = re.search(r"package: name='([^']+)' versionCode='([^']+)'", badging)
if not manifest or manifest.group(1) != PACKAGE:
    parser.error("指定APKはEidolonではありません")
expected_version = int(manifest.group(2))
result = {"package": PACKAGE, "expected_version": expected_version, "apk_sha256": hashlib.sha256(args.apk.read_bytes()).hexdigest(), "scene_ready": False, "xr_focused": False, "hmd_visual_confirmation": "pending"}
stream = None
stream_file = None
logs = ""
try:
    if adb("get-state").strip() != "device":
        raise RuntimeError("対象端末が承認済みdeviceではありません")
    result["model"] = adb("shell", "getprop", "ro.product.model").strip()
    result["api"] = int(adb("shell", "getprop", "ro.build.version.sdk").strip())
    if result["model"] != "Quest 3" or result["api"] < 34:
        raise RuntimeError("対象端末またはAndroid APIが想定外です")
    (run / "install.log").write_text(adb("install", "-r", str(args.apk.resolve()), timeout=120))
    adb("shell", "am", "force-stop", PACKAGE)
    started = adb("shell", "date", "+%m-%d_%H:%M:%S.000").strip().replace("_", " ")
    uid_text = adb("shell", "pm", "list", "packages", "-U", PACKAGE)
    uid_match = re.search(r"uid:(\d+)", uid_text)
    if not uid_match:
        raise RuntimeError("APK UIDを取得できませんでした")
    # 起動直後のログをring bufferの上書きで失わないよう、起動前から連続採取する。
    stream_file = (run / "app.log").open("w")
    stream = subprocess.Popen(["adb", "-s", args.serial, "logcat", "-v", "threadtime", "-T", started, "--uid=" + uid_match.group(1)], stdout=stream_file, stderr=subprocess.STDOUT)
    (run / "launch.log").write_text(adb("shell", "am", "start", "-W", "-n", PACKAGE + "/.MainActivity"))
    deadline = time.monotonic() + args.timeout
    logs = ""
    while time.monotonic() < deadline:
        pid_result = subprocess.run(["adb", "-s", args.serial, "shell", "pidof", PACKAGE], text=True, capture_output=True, timeout=10)
        pid = pid_result.stdout.strip()
        if pid:
            result["pid"] = int(pid.split()[0])
            own_pid = re.compile(r"^\d\d-\d\d \S+\s+" + str(result["pid"]) + r"\s+\d+\s+")
            logs = "\n".join(line for line in (run / "app.log").read_text().splitlines() if own_pid.match(line))
            if "FATAL EXCEPTION" in logs or "Fatal signal" in logs:
                raise RuntimeError("対象プロセスに致命的エラーがあります")
            result["xr_focused"] = "XR_SESSION_STATE_FOCUSED" in logs
            if f"scene_ready version={expected_version}" in logs and f"panel_created version={expected_version}" in logs:
                result["scene_ready"] = True
                if not args.require_focus or result["xr_focused"]:
                    break
        time.sleep(2)
    if not result["scene_ready"]:
        raise RuntimeError("scene_ready / panel_createdを制限時間内に確認できませんでした。HMDの装着状態とログを確認してください")
    if args.require_focus and not result["xr_focused"]:
        raise RuntimeError("XR FOCUSEDを確認できませんでした。HMD装着・system dialogを確認してください")
    time.sleep(3)
    if not adb("shell", "pidof", PACKAGE).strip():
        raise RuntimeError("scene生成後にプロセスが終了しました")
    logs = (run / "app.log").read_text()
    if "FATAL EXCEPTION" in logs or "Fatal signal" in logs:
        raise RuntimeError("scene生成後に致命的エラーがあります")
    (run / "battery.txt").write_text(adb("shell", "dumpsys", "battery"))
    package_info = adb("shell", "dumpsys", "package", PACKAGE)
    (run / "package.txt").write_text("\n".join(l for l in package_info.splitlines() if any(k in l for k in ("versionCode=", "versionName=", "primaryCpuAbi=", "DEBUGGABLE"))) + "\n")
    with (run / "screencap.png").open("wb") as out:
        subprocess.run(["adb", "-s", args.serial, "exec-out", "screencap", "-p"], stdout=out, check=True, timeout=30)
    result["status"] = "scene-ready"
except Exception as error:
    result["status"] = "failed"
    result["error"] = str(error)
    raise
finally:
    if stream is not None:
        stream.terminate()
        try:
            stream.wait(timeout=5)
        except subprocess.TimeoutExpired:
            stream.kill()
            stream.wait()
    if stream_file is not None:
        stream_file.close()
    (run / "result.json").write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n")
    print(json.dumps(result, ensure_ascii=False), flush=True)
