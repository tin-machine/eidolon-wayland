#!/usr/bin/env python3
"""debug APKでSDKなし/空SDK sceneのGPU FD比較。対象アプリを再起動する。"""
import argparse
import datetime
import json
import os
from pathlib import Path
import secrets
import shlex
import subprocess
import time

from gpu_fd_checks import validate
from native_build import identity
from quest_device import PACKAGE, QuestDevice, package_uid, work_root

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--serial', required=True)
parser.add_argument('--artifact-root', type=Path)
parser.add_argument('--pause-boundary', action='store_true', help='Guardianを一時pauseし、finallyで元値へ戻す')
args = parser.parse_args()
os.umask(0o077)
root = args.artifact_root or work_root() / 'eidolon-gpu-fds'
if not root.is_absolute(): parser.error('artifact rootは絶対pathを指定してください')
run = root / (datetime.datetime.now().strftime('%Y%m%dT%H%M%S') + '-' + secrets.token_hex(4))
run.mkdir(mode=0o700, parents=True)
device = QuestDevice(args.serial, run)
result = dict(status='running', acceptance='not_run', modes=[])
guardian = None
instrument = None
instrument_log = None
app_log = None
log_stream = None
prox = False
started = False
try:
    result['device'] = device.validate()
    uid = package_uid(device.adb('shell', 'pm', 'list', 'packages', '-U', PACKAGE))
    # 接続中の製品sessionを実験のために失わせない。
    live = device.adb('shell', 'pidof ' + PACKAGE + ' || true').strip()
    if live:
        raw = json.loads(device.adb('exec-out', 'run-as', PACKAGE, 'cat', 'no_backup/diagnostics/latest.json'))
        if str(raw.get('process_id')) == live:
            state = raw.get('runtime', {}).get('runtime', {})
            if state.get('transport', {}).get('owned_connections', 0) or (state.get('app') or {}).get('state') == 'running':
                raise RuntimeError('先に製品UIでSSH切断してください')
    if args.pause_boundary:
        guardian = device.adb('shell', 'getprop', 'debug.oculus.guardian_pause').strip()
        device.adb('shell', 'setprop', 'debug.oculus.guardian_pause', '1')
    app_log = (run / 'app.log').open('w')
    log_stream = device.start_log(uid, app_log)
    prox = True
    device.adb('shell', 'am', 'broadcast', '-a', 'com.oculus.vrpowermanager.prox_close')
    device.adb('shell', 'input', 'keyevent', 'KEYCODE_WAKEUP')
    for mode in ['platform', 'sdk']:
        nonce = secrets.token_hex(16)
        started = True
        device.adb('shell', 'am', 'force-stop', PACKAGE)
        print(mode + ' start', flush=True)
        if mode == 'platform':
            instrument_log = (run / 'instrumentation.log').open('w')
            instrument = subprocess.Popen(['adb', '-s', args.serial, 'shell', 'am', 'instrument', '-w', '-r',
                '-e', 'nonce', nonce, PACKAGE + '/.GpuFdInstrumentation'], stdout=instrument_log, stderr=subprocess.STDOUT)
        else:
            (run / 'sdk-launch.log').write_text(device.adb('shell', 'am', 'start', '-a', 'android.intent.action.MAIN',
                '-c', 'com.oculus.intent.category.VR', '-n',
                PACKAGE + '/.GpuFdSdkActivity', '--es', 'nonce', nonce))
        deadline = time.monotonic() + 180
        last_stage = None
        while True:
            if time.monotonic() > deadline: raise RuntimeError(mode + ' probe timeout')
            try:
                raw = device.adb('exec-out', 'run-as', PACKAGE, 'cat', 'no_backup/gpu-fd-probe/' + nonce + '.json')
                proof = json.loads(raw)
            except (RuntimeError, json.JSONDecodeError):
                if instrument is not None and instrument.poll() is not None: raise
                time.sleep(1); continue
            (run / (mode + '.json')).write_text(json.dumps(proof, indent=2) + '\n')
            if proof.get('stage') != last_stage:
                last_stage = proof.get('stage'); print(mode + ': ' + str(last_stage), flush=True)
            if proof.get('status') != 'running': break
            time.sleep(1)
        summary = validate(proof, nonce, mode, identity(proof['build'], 'debug'), uid)
        if instrument is not None:
            if instrument.wait(timeout=15) != 0: raise RuntimeError('instrumentation process failed')
            instrument_log.close(); instrument_log = None; instrument = None
            if 'INSTRUMENTATION_CODE: -1' not in (run / 'instrumentation.log').read_text():
                raise RuntimeError('instrumentation did not finish successfully')
        result['modes'].append(summary)
        print(json.dumps(summary), flush=True)
    result['status'] = 'observed'
except Exception as error:
    result['status'] = 'failed'
    result['failure_class'] = type(error).__name__
    raise
finally:
    # 復旧が一つ失敗しても残りを試す。元値が空の場合もshell quotingで保持する。
    cleanup = []
    actions = [('stop_probe', ('shell', 'am', 'force-stop', PACKAGE))] if started else []
    if guardian is not None:
        actions.append(('restore_guardian', ('shell', shlex.join(['setprop', 'debug.oculus.guardian_pause', guardian]))))
    if prox: actions.append(('restore_proximity', ('shell', 'am', 'broadcast', '-a', 'com.oculus.vrpowermanager.prox_far')))
    if started: actions.append(('restore_product_ui', ('shell', 'am', 'start', '-W', '-n', PACKAGE + '/.MainActivity')))
    for name, command in actions:
        try:
            device.adb(*command)
            if name == 'restore_guardian' and device.adb('shell', 'getprop', 'debug.oculus.guardian_pause').strip() != guardian:
                raise RuntimeError('Guardianの復帰値が不一致です')
            cleanup.append(dict(action=name, restored=True))
        except Exception: cleanup.append(dict(action=name, restored=False))
    if instrument is not None:
        try: instrument.wait(timeout=10)
        except subprocess.TimeoutExpired: instrument.terminate(); instrument.wait(timeout=5)
    if instrument_log is not None: instrument_log.close()
    if log_stream is not None: log_stream.terminate(); log_stream.wait(timeout=5)
    if app_log is not None: app_log.close()
    result['cleanup'] = cleanup
    (run / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
    print('artifacts: ' + str(run), flush=True)
    if not all(item['restored'] for item in cleanup): raise RuntimeError('復旧失敗。result.jsonを確認してください')
