#!/usr/bin/env python3
"""既にPCで識別済みのQuestへ、APKの公開鍵とTermuxの公開pinだけをpairingする。"""
import argparse
import datetime
import json
import os
from pathlib import Path
import shlex
import subprocess
import time

from pairing import PairError, canonical_key, profile, verify_device, fresh_runtime
from quest_device import PACKAGE, QuestDevice, work_root

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--serial", required=True)
parser.add_argument("--known-hosts", type=Path, default=Path.home() / ".ssh/eidolon_quest_known_hosts")
parser.add_argument("--artifact-root", type=Path)
args = parser.parse_args()
os.umask(0o077)
parent = args.artifact_root or work_root() / "eidolon-phase5-implementation/pairing"
if not parent.is_absolute():
    parser.error("artifact rootは絶対pathにしてください")
run = parent / (datetime.datetime.now().strftime("%Y%m%dT%H%M%S") + "-" + str(os.getpid()))
run.mkdir(mode=0o700, parents=True)
device = QuestDevice(args.serial, run)
result = {"schema": 1, "status": "fail", "stage": "verify_device"}


def write_public(command, packet):
    # shellへ渡すcommandは固定program/source/pathのみ。公開値はstdinから渡す。
    remote = shlex.join(command)
    with (run / "commands.log").open("a") as output:
        output.write(json.dumps(["adb", "-s", "[ADB_TARGET]", "shell", "-T", "[FIXED_PAIR_PROGRAM]"]) + "\n")
    completed = subprocess.run(["adb", "-s", args.serial, "shell", "-T", remote],
                               input=json.dumps(packet), capture_output=True, text=True, timeout=30)
    if completed.returncode:
        raise PairError("PAIR_WRITE_FAILED")
    return completed.stdout


try:
    device.validate()
    physical = device.adb("shell", "getprop", "ro.serialno").strip()
    host = device.adb("exec-out", "run-as", "com.termux", "cat", "files/usr/etc/ssh/ssh_host_ed25519_key.pub")
    if not args.known_hosts.is_file():
        raise PairError("DEVICE_NOT_ENROLLED")
    verify_device(physical, args.known_hosts.read_text(), host)
    result.update(device_verified=True, known_host_verified=True)
    try:
        device.adb("shell", shlex.join(["run-as", "com.termux", "/system/bin/sh", "-c", "test -x /data/data/com.termux/files/usr/bin/python"]))
    except RuntimeError:
        raise PairError("TERMUX_PYTHON_REQUIRED") from None
    result["stage"] = "app_identity"
    device.adb("shell", "am", "start", "-n", PACKAGE + "/.MainActivity")
    deadline = time.monotonic() + 30
    while True:
        try:
            public = json.loads(device.adb("exec-out", "run-as", PACKAGE, "cat", "no_backup/credentials/public.json"))
            diagnostic = json.loads(device.adb("exec-out", "run-as", PACKAGE, "cat", "no_backup/diagnostics/latest.json"))
            if diagnostic["build_info"]["profile"] != "debug":
                raise PairError("DEBUG_APK_REQUIRED")
            break
        except (RuntimeError, json.JSONDecodeError, KeyError):
            if time.monotonic() >= deadline:
                raise PairError("APP_IDENTITY_NOT_READY") from None
            time.sleep(0.25)
    username = device.adb("exec-out", "run-as", "com.termux", "/system/bin/id", "-un").strip()
    read_profile = "if [ -e no_backup/credentials/profile.json ]; then cat no_backup/credentials/profile.json; else printf null; fi"
    previous = json.loads(device.adb("shell", shlex.join(["run-as", PACKAGE, "/system/bin/sh", "-c", read_profile])))
    candidate = profile(public, username, host, previous)
    result["stage"] = "authorized_keys"
    helper = (Path(__file__).resolve().parent / "pairing.py").read_text()
    updated = json.loads(write_public(["run-as", "com.termux", "/data/data/com.termux/files/usr/bin/python", "-c", helper],
                                      {"schema": 1, "public_key": canonical_key(public["public_key"])}))
    if updated.get("schema") != 1 or updated.get("existing_entries_preserved") is not True:
        raise PairError("AUTHORIZED_KEYS_FAILED")
    result["stage"] = "profile"
    write_public(["run-as", PACKAGE, "/system/bin/sh", "-c",
                  "umask 077; cat > no_backup/credentials/profile.json.tmp && mv no_backup/credentials/profile.json.tmp no_backup/credentials/profile.json"], candidate)
    old_pid = device.adb("shell", "pidof", PACKAGE).strip()
    device.adb("shell", "am", "force-stop", PACKAGE)
    result["stage"] = "app_return"
    device.adb("shell", "am", "start", "-n", PACKAGE + "/.MainActivity")
    deadline = time.monotonic() + 30
    while True:
        try:
            after = json.loads(device.adb("exec-out", "run-as", PACKAGE, "cat", "no_backup/credentials/public.json"))
            current = json.loads(device.adb("exec-out", "run-as", PACKAGE, "cat", "no_backup/diagnostics/latest.json"))
            pid = device.adb("shell", "pidof", PACKAGE).strip()
            if after != public:
                raise PairError("APP_IDENTITY_CHANGED")
            if fresh_runtime(current, pid, old_pid, diagnostic["build_info"]):
                break
        except (RuntimeError, json.JSONDecodeError, KeyError):
            pass
        if time.monotonic() >= deadline:
            raise PairError("APP_RETURN_TIMEOUT")
        time.sleep(0.25)
    result.update(status="pass", stage="complete", authorized_changed=updated["changed"], existing_entries_preserved=True,
                  profile_saved=True, installation_unchanged=True, normal_runtime_returned=True)
except Exception as error:
    result.update(error_class=type(error).__name__, error_code=str(error) if isinstance(error, PairError) else "PAIR_FAILED")
finally:
    (run / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result))
raise SystemExit(0 if result["status"] == "pass" else 1)
