#!/data/data/com.termux/files/usr/bin/bash
# Bionic 用のアドオンと辞書を専用ディレクトリに配置する。
set -euo pipefail
umask 077
: "${PREFIX:?Termux のシェルで実行してください}"
tools_dir=$(cd "$(dirname "$0")" && pwd)
revision=d55a0517e127c24def4d498d2428c39f956525ae
work=${1:-"$HOME/.local/share/eidolon-ime-native/${revision:0:7}"}
mkdir -p "$work"
cd "$work"
work=$PWD

# A checkout owned by this build can be resumed after an interrupted fetch.
if [[ ! -d src/.git ]]; then
    git init -q src
    git -C src remote add origin https://github.com/fcitx-contrib/fcitx5-mozc.git
fi
if ! git -C src cat-file -e "$revision^{commit}" 2>/dev/null; then
    git -C src fetch --depth=1 origin "$revision"
fi
if [[ $(git -C src rev-parse --verify HEAD 2>/dev/null || true) != "$revision" ]]; then
    git -C src checkout --detach "$revision"
fi
git -C src submodule update --init --depth=1

apply_once() {
    local dir=$1 patch_file=$2
    if ! git -C "$dir" apply --reverse --check "$patch_file" 2>/dev/null; then
        git -C "$dir" apply "$patch_file"
    fi
}
apply_once src/protobuf "$work/src/patches/protobuf.patch"
apply_once src "$tools_dir/mozc-termux.patch"
apply_once src/mozc "$tools_dir/mozc-profile.patch"

dictionary=build/data_manager/oss/mozc_data.inc
dictionary_hash=f918272cdd0ba0d0ce850bfe18588994ea4eecf889e9ef387a48f2014c960f61
mkdir -p "$(dirname "$dictionary")"
if [[ ! -f "$dictionary" ]]; then
    curl -fsSL --retry 2 -o "$dictionary.part" \
        https://github.com/fcitx-contrib/fcitx5-mozc/releases/download/latest/mozc_data.inc
    printf '%s  %s\n' "$dictionary_hash" "$dictionary.part" | sha256sum -c -
    mv "$dictionary.part" "$dictionary"
else
    printf '%s  %s\n' "$dictionary_hash" "$dictionary" | sha256sum -c -
fi

cmake -S src -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_PREFIX_PATH="$PREFIX" \
    -DCMAKE_CXX_FLAGS="-I$PREFIX/include/Fcitx5/Module" -Dprotobuf_BUILD_TESTS=OFF
cmake --build build --target mozc --parallel "${JOBS:-2}"
install -D -m 700 build/src/unix/fcitx5/libmozc.so stage/lib/fcitx5/libmozc.so
install -D -m 600 build/src/unix/fcitx5/mozc-addon.conf stage/share/fcitx5/addon/mozc.conf
install -D -m 600 src/src/unix/fcitx5/mozc.conf stage/share/fcitx5/inputmethod/mozc.conf
