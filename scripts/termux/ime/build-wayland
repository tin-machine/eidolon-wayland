#!/data/data/com.termux/files/usr/bin/bash
# 配布済み Fcitx5 と同じ ABI の Wayland フロントエンドと候補 UI を作る。
set -euo pipefail
umask 077
: "${PREFIX:?Termux のシェルで実行してください}"
version=5.1.23
revision=27cca6e0239938b2d53937061d0980c087856b22
recipe=4977ed6e93ae288cddba46d15e6ffcc4287bd4b6
work=${1:-"$HOME/.local/share/eidolon-ime-native/d55a051"}
[[ $(pkg-config --modversion Fcitx5Core) == "$version" ]] || {
    echo "Fcitx5Core $version が必要です。配布版との ABI を確認してください。" >&2
    exit 1
}
mkdir -p "$work"
cd "$work"
if [[ ! -d fcitx/.git ]]; then
    git clone --depth=1 --branch "$version" https://github.com/fcitx/fcitx5.git fcitx
fi
[[ $(git -C fcitx rev-parse HEAD) == "$revision" ]]
mkdir -p fcitx-patches
for name in cmake-FindDL.cmake cmake-FindPthread.cmake fix-hardcoded-paths src-modules-spell-CMakeLists.txt; do
    patch_file="$PWD/fcitx-patches/$name.patch"
    curl -fsSL --retry 2 "https://raw.githubusercontent.com/termux/termux-packages/$recipe/x11-packages/fcitx5/$name.patch" |
        sed "s|@TERMUX_PREFIX@|$PREFIX|g" > "$patch_file"
    if ! git -C fcitx apply --reverse --check "$patch_file" 2>/dev/null; then
        git -C fcitx apply "$patch_file"
    fi
done
cmake -S fcitx -B fcitx-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_PREFIX_PATH="$PREFIX" \
    -DDL_INCLUDE_DIR="$PREFIX/include" -DDL_LIBRARY=0 -DPTHREAD_INCLUDE_DIR="$PREFIX/include" \
    -DENABLE_TEST=OFF -DENABLE_WAYLAND=ON -DUSE_SYSTEM_YOGA=ON \
    -DUSE_SYSTEM_PLASMA_WAYLAND_PROTOCOLS=OFF -DCMAKE_CXX_FLAGS=-fexperimental-library \
    -DCMAKE_SHARED_LINKER_FLAGS=-ldl -DCMAKE_EXE_LINKER_FLAGS=-ldl
addons=(modules/wayland frontend/waylandim ui/classic)
names=(wayland waylandim classicui)
targets=("${names[@]}")
for i in "${!names[@]}"; do
    targets+=("src/${addons[i]}/${names[i]}.conf")
done
cmake --build fcitx-build --parallel "${JOBS:-2}" --target "${targets[@]}"
for i in "${!names[@]}"; do
    name=${names[i]}
    install -D -m 700 "fcitx-build/bin/lib$name.so" "stage/lib/fcitx5/lib$name.so"
    install -D -m 600 "fcitx-build/src/${addons[i]}/$name.conf" "stage/share/fcitx5/addon/$name.conf"
done
