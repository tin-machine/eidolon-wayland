#!/usr/bin/env python3
"""CI gate for the implemented foundation, explicitly not the complete A0 gate.

The operator feasibility CLI still exits nonzero while the two GUI oracles are
pending. This CI gate requires every currently implemented check, the exact
pending set, and complete actual process cleanup. Runtime failures cannot be
reclassified as the expected incomplete outcome.
"""
import argparse
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import linux_real_app_check as check
import linux_real_app_inspect as inspect


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact-root", required=True, type=Path)
    parser.add_argument("--reviewed-package", required=True, type=Path)
    args = parser.parse_args()
    os.umask(0o077)
    result = check.run_feasibility(args.artifact_root, inspect._read_operator_descriptor(args.reviewed_package))
    required_settings = {"policy_values_types_and_readonly", "ordinary_notifications_and_transactions",
                         "ordinary_persistence_in_new_process", "separate_profile_isolation",
                         "missing_module_fallback_rejected", "invalid_profile_exits_without_fallback"}
    required_recovery = {"empty_profile_admitted", "nonempty_session_refused", "autosave_refused", "recovery_bytes_preserved"}
    checks = result.get("checks", {})
    valid = (result.get("status") == "incomplete" and result.get("reason") == "APP_A0_INCOMPLETE"
             and result.get("a0_passed") is False and result.get("available") is False
             and result.get("production_acceptance_passed") is False and result.get("quest_verified") is False
             and result.get("pending") == list(check.FOUNDATION_PENDING) + ["v3_acceptance", "quest"]
             and all(checks.get("settings", {}).get(name) is True for name in required_settings)
             and all(checks.get("recovery", {}).get(name) is True for name in required_recovery)
             and checks.get("recovery", {}).get("application_spawned_for_seeded_recovery") is False)
    if valid:
        check.validate_application_foundation(checks.get("application"))
    lifecycle = checks.get("application", {}).get("lifecycle", {})
    print(json.dumps({"schema": 1, "foundation_verified": valid, "a0_passed": False,
                      "reason": result.get("reason"), "pending": result.get("pending"),
                      "application_error": checks.get("application", {}).get("error"),
                      "restart_outcomes": {name: case.get("outcome") for name, case in lifecycle.get("cases", {}).items()},
                      "recovery_cases": sorted(lifecycle.get("recovery", {})),
                      "independent_instance": checks.get("application", {}).get("checks", {}).get("independent_instance") is True,
                      "available": False, "quest_verified": False}, sort_keys=True))
    return 0 if valid else 1


if __name__ == "__main__":
    raise SystemExit(main())
