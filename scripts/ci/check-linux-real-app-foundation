#!/usr/bin/env python3
"""CI gate for measured A0, independently of v3 and Quest acceptance.

Require both genuine GUI oracles, every previous settings/lifecycle check and
complete actual cleanup. An incomplete, skipped or failed GUI experiment is
not accepted even when the older foundation checks passed.
"""
import argparse
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import linux_real_app_check as check
import linux_real_app_inspect as inspect


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact-root", required=True, type=Path)
    parser.add_argument("--reviewed-package", required=True, type=Path)
    parser.add_argument("--precursor-hold-check", action="store_true",
                        help="Require a measured 125-second live precursor hold and fresh GUI response")
    args = parser.parse_args()
    os.umask(0o077)
    result = check.run_feasibility(args.artifact_root, inspect._read_operator_descriptor(args.reviewed_package),
                                   precursor_hold_check=args.precursor_hold_check)
    checks = result.get("checks", {})
    try:
        check.validate_feasibility_a0(result, require_precursor_hold=args.precursor_hold_check)
        valid = True
    except (check.BuildError, KeyError, TypeError, ValueError):
        valid = False
    lifecycle = checks.get("application", {}).get("lifecycle", {})
    print(json.dumps({"schema": 1, "foundation_verified": valid, "a0_passed": valid,
                      "reason": result.get("reason"), "pending": result.get("pending"),
                      "application_error": checks.get("application", {}).get("error"),
                      "restart_outcomes": {name: case.get("outcome") for name, case in lifecycle.get("cases", {}).items()},
                      "recovery_cases": sorted(lifecycle.get("recovery", {})),
                      "precursor_hold_ms": (lifecycle.get("independence", {}).get("hold_probe") or {}).get("elapsed_ms"),
                      "independent_instance": checks.get("application", {}).get("checks", {}).get("independent_instance") is True,
                      "gui_setting_persistence": checks.get("application", {}).get("checks", {}).get("gui_setting_persistence") is True,
                      "protected_settings_gui_readonly": checks.get("application", {}).get("checks", {}).get("protected_settings_gui_readonly") is True,
                      "available": False, "production_acceptance_passed": False, "quest_verified": False}, sort_keys=True))
    return 0 if valid else 1


if __name__ == "__main__":
    raise SystemExit(main())
