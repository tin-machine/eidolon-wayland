#!/usr/bin/env python3
"""固定GTK3 fixtureのinput/dialog/resizeを同じlease/SDK jobで一回確認する。"""
import argparse
import base64
import datetime
import hashlib
import json
import os
from pathlib import Path
import secrets
import selectors
import shlex
import subprocess
import time
import zlib

from gui_probe_sdk import digest_sources
from gtk_interaction_run import CASES, OPERATOR, completed
from gtk_interaction_evidence import baseline_resources, android_receipt, current_frame, ready, receipt_binding, sample, summarize
from native_build import ROOT
from quest_device import PACKAGE, QuestDevice, package_uid, work_root
from sdl_lease_capture import CaptureError, MAX_SNAPSHOT, binding_key, canonical, decode, hexadecimal, need, select_snapshot

OPERATOR_SOURCES=("scripts/quest-run-gtk-interaction","scripts/gtk_interaction_evidence.py","scripts/gtk_interaction_run.py",
                  "scripts/gtk_probe_run.py","scripts/sdl_probe_run.py","scripts/sdl_lease_capture.py","scripts/sdl_probe_install.py",
                  "scripts/termux/eidolon-sdl-probe.py","scripts/fixtures/gtk3-interaction-fixture.c","scripts/termux/build-gtk3-fixture.py")


def operator_hashes():
    return {path:hashlib.sha256((ROOT/path).read_bytes()).hexdigest() for path in OPERATOR_SOURCES}


def remote_source():
    source = "import sys,types\n"
    for name, relative in (("sdl_probe_install", "scripts/sdl_probe_install.py"), ("sdl_lease_capture", "scripts/sdl_lease_capture.py"),
                           ("sdl_probe_run", "scripts/sdl_probe_run.py"), ("sdl_observation", "scripts/termux/eidolon-sdl-probe.py"),
                           ("gtk_probe_run", "scripts/gtk_probe_run.py"), ("gtk_interaction_run", "scripts/gtk_interaction_run.py")):
        data=(ROOT/relative).read_text()
        if name=="sdl_probe_run":
            # lease/file/group検査だけを再利用し、無関係なSDL実行本体はADBへ送らない。
            need("\ndef run_operator(" in data,"REMOTE_SOURCE_SCHEMA")
            data=data.split("\ndef run_operator(",1)[0]
        source += f"m=types.ModuleType({name!r});exec({data!r},m.__dict__);sys.modules[m.__name__]=m\n"
    files = {"gtk3-interaction-fixture.c": "scripts/fixtures/gtk3-interaction-fixture.c", "build-gtk3-fixture.py": "scripts/termux/build-gtk3-fixture.py"}
    pins = {name:dict(bytes=(ROOT/path).stat().st_size, sha256=hashlib.sha256((ROOT/path).read_bytes()).hexdigest()) for name,path in files.items()}
    source += f"sys.modules['gtk_interaction_run'].SOURCE_PINS={pins!r}\nraise SystemExit(sys.modules['gtk_interaction_run'].remote_main())\n"
    encoded = base64.b64encode(zlib.compress(source.encode(), 9)).decode("ascii")
    return f"import base64,zlib;exec(zlib.decompress(base64.b64decode({encoded!r})))"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--serial", required=True);parser.add_argument("--case", choices=sorted(CASES), required=True)
    parser.add_argument("--run-id", required=True);parser.add_argument("--binary-sha256", required=True);parser.add_argument("--manifest-sha256", required=True)
    parser.add_argument("--artifact-root", type=Path)
    args = parser.parse_args()
    if not hexadecimal(args.run_id,32) or not hexadecimal(args.binary_sha256,64) or not hexadecimal(args.manifest_sha256,64): parser.error("run-idと期待SHAは固定長の小文字hexです")
    os.umask(0o077)
    nonce = secrets.token_hex(16)
    root = args.artifact_root or work_root()/"eidolon-gtk-interaction"
    if not root.is_absolute(): parser.error("artifact rootは絶対pathです")
    run = root/(datetime.datetime.now().strftime("%Y%m%dT%H%M%S-%f")+"-"+nonce);run.mkdir(mode=0o700,parents=True)
    device = QuestDevice(args.serial,run)
    result = dict(schema=1,operator=OPERATOR,status="failed",case=args.case,nonce=nonce,run_id=args.run_id,
                  sdk_samples=[],fixture_reports=[],android_receipts=[],events=[],physical_input="not_run",ime="not_run",hmd="not_run")
    child=selector=None;cancelled=started_android=closed_android=dismissed_android=False;initial_content=None
    def control_cancel():
        nonlocal cancelled
        if child is not None and not cancelled and not child.stdin.closed:
            try: child.stdin.write(b'{"type":"cancel"}\n');child.stdin.flush();cancelled=True
            except (OSError,ValueError): pass
    def close_input():
        if child is not None and not child.stdin.closed:
            try: child.stdin.close()
            except (OSError,ValueError): pass
    def broadcast(case):
        device.adb("shell","am","broadcast","-n",PACKAGE+"/.GtkFixtureCommandReceiver","-a",PACKAGE+".GTK_FIXTURE_COMMAND",
                   "--es","case",case,"--es","nonce",nonce,timeout=5)
    def snapshot():
        p=subprocess.run(["adb","-s",args.serial,"exec-out","run-as",PACKAGE,"head","-c",str(MAX_SNAPSHOT+1),"no_backup/diagnostics/latest.json"],capture_output=True,timeout=5)
        need(p.returncode==0,"DIAGNOSTICS_UNAVAILABLE");return decode(p.stdout)
    try:
        source_pins=operator_hashes();result["operator_source_sha256"]=source_pins
        result["device"]=device.validate();need(package_uid(device.adb("shell","pm","list","packages","-U","com.termux"),"com.termux")==10158,"GTK_UID_MISMATCH")
        digest=digest_sources();initial=snapshot();binding=select_snapshot(initial,digest,10158);scene=initial["runtime"]["runtime"]["scene"]
        need(device.adb("shell","pidof",PACKAGE).strip()==str(binding["process_id"]),"APK_PROCESS_NOT_CURRENT")
        baseline={w["window"] for w in initial["runtime"]["runtime"]["app"]["windows"] if w["life"]=="Mapped"}
        need(len(baseline)==1,"ONE_BASELINE_WINDOW_REQUIRED")
        initial_sample=sample(initial,nonce,baseline)
        result["sdk_samples"].append(initial_sample)
        need(baseline_resources(initial_sample["resources"],baseline,[t["key"] for t in initial_sample["targets"]]),"GTK_BASELINE_RESOURCE_NOT_READY")
        need(baseline<={t["key"]["window"] for t in initial_sample["targets"] if t["frames"]>=1 and t["content_frame"] is not None},"GTK_BASELINE_TARGET_NOT_READY")
        prior=initial.get("check",{});need(prior.get("result") not in {"running"},"OTHER_DEBUG_CASE_RUNNING")
        result["binding"]=binding
        request=dict(binding=binding,case=args.case,nonce=nonce,run_id=args.run_id,binary_sha256=args.binary_sha256,manifest_sha256=args.manifest_sha256)
        (run/"request.json").write_bytes(canonical(request)+b"\n")
        command=shlex.join(["run-as","com.termux","/data/data/com.termux/files/usr/bin/python3","-c",remote_source()])
        need(len(command.encode())<=49*1024,"REMOTE_COMMAND_LIMIT");result["remote_command_bytes"]=len(command.encode())
        child=subprocess.Popen(["adb","-s",args.serial,"shell","-T",command],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        child.stdin.write(canonical(request)+b"\n");child.stdin.flush()
        selector=selectors.DefaultSelector()
        for name in ("stdout","stderr"):
            pipe=getattr(child,name);os.set_blocking(pipe.fileno(),False);selector.register(pipe,selectors.EVENT_READ,name)
        begin=time.monotonic();last_poll=0.;pending=bytearray();sizes=dict(stdout=0,stderr=0);finished=None;latest_android=None
        latest=None;ended=None;observed_main=set();observed_dialog=set()
        while time.monotonic()-begin<45:
            now=time.monotonic()
            if now-last_poll>=.1:
                last_poll=now;value=snapshot();current=select_snapshot(value,digest,10158)
                need(binding_key(current)==binding_key(binding),"APK_BINDING_CHANGED")
                need(value["runtime"]["runtime"]["scene"]==scene,"GTK_SCENE_CHANGED")
                latest=sample(value,nonce,baseline)
                need(baseline<={t["key"]["window"] for t in latest["targets"] if t["frames"]>=1 and t["content_frame"] is not None},"GTK_BASELINE_TARGET_LOST")
                observed_main.update(w["window"] for w in latest["windows"] if w["role"]=="main")
                observed_dialog.update(w["window"] for w in latest["windows"] if w["role"]=="dialog")
                if not result["sdk_samples"] or result["sdk_samples"][-1]["sequence"]!=latest["sequence"]:
                    need(len(result["sdk_samples"])<512,"SDK_SAMPLE_LIMIT");result["sdk_samples"].append(latest)
                receipt=android_receipt(value,nonce,args.case)
                if receipt is not None:
                    if receipt["result"] in {"failed","cancelled","unsupported"}:
                        result["android_failure"]=receipt["reason"] or receipt["result"];control_cancel()
                    receipt_binding(receipt,binding,scene,baseline,observed_main,observed_dialog)
                    latest_android=receipt
                    if not result["android_receipts"] or receipt!=result["android_receipts"][-1]: result["android_receipts"].append(receipt)
                    if receipt["result"] in {"failed","cancelled","unsupported"}:
                        result["android_failure"]=receipt["reason"] or receipt["result"];control_cancel()
            for key,_ in selector.select(.02):
                data=os.read(key.fd,8192)
                if not data:selector.unregister(key.fd);continue
                sizes[key.data]+=len(data)
                if key.data=="stderr":
                    if sizes["stderr"]>65536:control_cancel()
                    continue
                need(sizes["stdout"]<=1048576,"REMOTE_OUTPUT_LIMIT");pending.extend(data)
                while b"\n" in pending:
                    line,_,rest=pending.partition(b"\n");pending=bytearray(rest);event=decode(line,524288)
                    need(type(event) is dict and event.get("phase") in {"validated","started","fixture","finished","blocked"},"REMOTE_EVENT_INVALID")
                    if event["phase"]=="fixture":
                        # remoteは固定C schemaを検査済み。hostでもnonce/caseを照合する。
                        row=event["report"];need(row.get("run_id")==nonce and row.get("case")==args.case,"GTK_CLIENT_OWNER_CHANGED")
                        need(len(result["fixture_reports"])<256,"GTK_REPORT_LIMIT");result["fixture_reports"].append(row)
                    elif event["phase"]=="finished":
                        finished=event["result"];need(finished.get("operator")==OPERATOR and finished.get("nonce")==nonce and
                            finished.get("binary_sha256")==args.binary_sha256 and finished.get("manifest_sha256")==args.manifest_sha256,"GTK_RESULT_MISMATCH")
                        ended=time.monotonic();close_input()
                    elif event["phase"]=="blocked": result["blocked_reason"]=event.get("reason");ended=time.monotonic();close_input()
                    else: need(len(result["events"])<2,"REMOTE_EVENT_INVALID");result["events"].append(event)
            rows=result["fixture_reports"];last_row=rows[-1] if rows else None
            if not cancelled and finished is None and not started_android and latest and last_row and ready(latest,last_row,args.case) and current_frame(latest,"main") is not None:
                initial_content=current_frame(latest,"main")
                need(initial_content is not None,"GTK_FRAME_NOT_CURRENT")
                broadcast("gtk-"+args.case);started_android=True
            if not cancelled and started_android and not dismissed_android and latest_android and latest_android["phase"]=="DIALOG_READY" and last_row and last_row["dialog_visible"] and last_row["dialog_draws"]>=1 and current_frame(latest,"dialog") is not None:
                broadcast("gtk-dialog-dismiss");dismissed_android=True
            fresh=current_frame(latest,"main") if latest else None
            if not cancelled and finished is None and started_android and not closed_android and latest_android and latest_android["phase"]=="OPERATIONS_COMPLETE" and completed(last_row,args.case) and fresh is not None and (args.case!="input" or fresh>initial_content):
                broadcast("gtk-close");closed_android=True
            if ended is not None and latest_android and latest_android["result"]=="completed" and summarize(result["sdk_samples"],baseline,args.case,result["fixture_reports"],latest_android)["all_retired"]:break
            if ended is not None and time.monotonic()-ended>=8:break
            if child.poll() is not None and not selector.get_map() and ended is None:break
        if ended is None:control_cancel()
        close_input();child.wait(timeout=6)
        result.update(remote_returncode=child.returncode,remote_result=finished,output_bytes=sizes)
        need(digest_sources()==digest and operator_hashes()==source_pins,"SOURCE_CHANGED")
        result["evidence"]=summarize(result["sdk_samples"],baseline,args.case,result["fixture_reports"],latest_android)
        result["status"]="observed" if finished and finished.get("status")=="observed" and child.returncode==0 and result["evidence"]["status"]=="observed" and not result.get("android_failure") else "failed"
    except (OSError,ValueError,TypeError,KeyError,RuntimeError,subprocess.SubprocessError) as error:
        result["reason"]=error.reason if isinstance(error,CaptureError) else "GTK_HOST_OPERATOR_UNAVAILABLE";control_cancel()
    finally:
        if started_android:
            try:broadcast("gtk-cancel")
            except (OSError,RuntimeError,subprocess.SubprocessError):result["android_cancel_unconfirmed"]=True
        if child is not None:
            close_input()
            try:child.wait(timeout=6)
            except (OSError,subprocess.SubprocessError):
                result["remote_cleanup_unconfirmed"]=True;child.terminate()
                try:child.wait(timeout=2)
                except (OSError,subprocess.SubprocessError):pass
            result.setdefault("remote_returncode",child.returncode);child.stdout.close();child.stderr.close()
        if selector is not None:selector.close()
        (run/"result.json").write_text(json.dumps(result,indent=2)+"\n")
    print(json.dumps(dict(status=result["status"],artifact=str(run),case=args.case,nonce=nonce,reason=result.get("android_failure") or result.get("reason"))))
    return 0 if result["status"]=="observed" else 1


if __name__=="__main__":raise SystemExit(main())
