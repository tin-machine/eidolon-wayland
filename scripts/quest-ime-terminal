#!/usr/bin/env python3
"""debug端末IMEを開始・切替・終了する。実かな漢字変換/物理/HMDの合格にはしない。"""
import argparse
import datetime
import json
import os
from pathlib import Path
import re
import secrets
import time

from quest_device import PACKAGE, QuestDevice, work_root

KEYS = {'case','nonce','result','scope','phase','reason','toggles','sdk_down_submitted','sdk_up_submitted',
        'sdk_tap_failed','editor_attached','editor_view_focus','editor_window_focus','editor_connection_active',
        'enqueued','applied','pending_acks','focus_requests','focus_observed','last_external_loss','native_raw_blocked','android_released','raw_return','failure','connection_failure','raw_return_failure',
        'editor_permanently_closed','closed_editor_fixture_passed','editor_imm_active','editor_imm_accepting_text','acceptance'}
BOOLS = {'sdk_down_submitted','sdk_up_submitted','sdk_tap_failed','editor_attached','editor_view_focus',
         'editor_window_focus','editor_connection_active','native_raw_blocked','android_released','focus_observed','editor_permanently_closed',
         'closed_editor_fixture_passed','editor_imm_active','editor_imm_accepting_text'}
NUMBERS = {'toggles','enqueued','applied','pending_acks','focus_requests'}
PHASES = {'WAITING_TARGET','DIRECT_READY','CONNECTING','TARGET_UNAVAILABLE','OWNER_UNAVAILABLE','STOPPED',
          'IDLE','ENABLING','NEEDS_RESET','RESETTING','NEEDS_FOCUS','FOCUSING','WAITING_CLIENT','BOUND','SUSPENDED',
          'CLOSING','CLOSED','SDK_CLEANUP','WAITING_CLEANUP','WAITING_FOCUS','COMPLETE','CANCELLED','FAILED'}
REASONS = {'preparing','off_requested','on_requested','ready','editor_bounds_unavailable','handoff_not_confirmed',
           'editor_window_lost','activity_paused','external_focus_lost','scene_closed','operator_stop','panel_stop',
           'editor_attach_failed','sdk_cleanup_pending','timeout','target_not_ready','controller_failure','focus_requested','closed_editor_fixture_failed'}
FAILURES = {'closed','bridge_invalidated','reset_rejected','target_unavailable','invalid_snapshot','ack_timeout',
            'control_rejected','focus_changed','snapshot_target_changed','binding_rejected','ack_limit','request_collision',
            'enqueue_rejected','key_rejected','cleanup_unconfirmed','owner_changed','return_timeout',
            'focus_enqueue_rejected','focus_delivery_rejected'}

def receipt(device, nonce):
    raw = device.adb('exec-out','run-as',PACKAGE,'head','-c','1048577','no_backup/diagnostics/latest.json',timeout=10)
    if len(raw.encode())>1048576:
        raise ValueError('METADATA_LIMIT')
    value = json.loads(raw).get('check')
    if not isinstance(value,dict) or value.get('case')!='ime-terminal' or value.get('nonce')!=nonce:
        return None
    if set(value)!=KEYS or value['scope']!='debug_terminal_ime' or value['result'] not in {'running','completed'}:
        raise ValueError('METADATA_SCHEMA')
    if any(type(value[k]) is not bool for k in BOOLS) or any(type(value[k]) is not int or not 0<=value[k]<=2**63-1 for k in NUMBERS):
        raise ValueError('METADATA_TYPE')
    if value['phase'] not in PHASES or value['reason'] not in REASONS or any(value[k] not in FAILURES | {None} for k in ('failure','connection_failure','raw_return_failure')):
        raise ValueError('METADATA_TOKEN')
    if value['last_external_loss'] not in {None,'editor_window_lost','activity_paused','external_focus_lost','handoff_not_confirmed'}:
        raise ValueError('METADATA_TOKEN')
    if value['raw_return'] not in {'not_requested','WAITING_CLEANUP','WAITING_FOCUS','COMPLETE','CANCELLED','FAILED'}:
        raise ValueError('METADATA_TOKEN')
    if value['acceptance']!={'actual_ime':'not_verified','physical_input':'not_verified','hmd':'not_verified'}:
        raise ValueError('METADATA_ACCEPTANCE')
    return value

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=('start','status','focus','toggle','stop'))
    parser.add_argument('--serial',required=True)
    parser.add_argument('--nonce')
    parser.add_argument('--artifact-root',type=Path)
    parser.add_argument('--timeout',type=int,default=55)
    args=parser.parse_args()
    nonce=args.nonce or (secrets.token_hex(16) if args.action=='start' else '')
    if not re.fullmatch('[0-9a-f]{32}',nonce) or not 1<=args.timeout<=60:
        parser.error('32桁小文字hex nonceと1〜60秒timeoutが必要です')
    os.umask(0o077)
    parent=args.artifact_root or work_root()/'eidolon-ime-terminal'
    if not parent.is_absolute():parser.error('artifact rootは絶対pathです')
    run=parent/(datetime.datetime.now().strftime('%Y%m%dT%H%M%S-%f')+'-'+args.action)
    run.mkdir(parents=True,mode=0o700)
    device=QuestDevice(args.serial,run)
    result=dict(schema=1,action=args.action,nonce=nonce,status='failed',acceptance='not_verified',artifact=str(run))
    try:
        result.update(device.validate())
        try: before=receipt(device,nonce)
        except (RuntimeError,json.JSONDecodeError):before=None
        if args.action=='start':
            if before is not None:raise ValueError('NONCE_ALREADY_OBSERVED')
            device.adb('shell','am','start','-n',PACKAGE+'/.DebugCommandActivity','--es','case','ime-terminal','--es','nonce',nonce)
        elif args.action in {'focus','toggle','stop'}:
            if before is None or before['result']!='running':raise ValueError('OWNER_NOT_RUNNING')
            # NoDisplay ActivityでもonPauseを誘発し得るため、継続操作はshell権限の固定receiverへ送る。
            device.adb('shell','am','broadcast','-n',PACKAGE+'/.ImeTerminalCommandReceiver',
                       '-a',PACKAGE+'.IME_TERMINAL_COMMAND','--es','case','ime-terminal-'+args.action,'--es','nonce',nonce)
        deadline=time.monotonic()+args.timeout
        while time.monotonic()<deadline:
            value=receipt(device,nonce)
            if value is not None:
                (run/'metadata.json').write_text(json.dumps(value,ensure_ascii=False,indent=2)+'\n')
                ready=args.action=='status' or (args.action=='start' and value['phase'] in {'DIRECT_READY','TARGET_UNAVAILABLE'}) or (
                    args.action=='toggle' and value['toggles']>before['toggles']) or (
                    args.action=='focus' and value['focus_requests']>before['focus_requests'] and value['focus_observed'] and value['phase']=='DIRECT_READY') or (args.action=='stop' and value['result']=='completed')
                if ready:
                    result.update(status='observed',phase=value['phase'],result=value['result'],raw_return=value['raw_return'])
                    break
            time.sleep(.2)
        else:raise TimeoutError('METADATA_TIMEOUT')
    except Exception as error:
        result['failure_class']=type(error).__name__
        if isinstance(error,(ValueError,TimeoutError)) and re.fullmatch('[A-Z_]{3,64}',str(error)):
            result['failure_code']=str(error)
    (run/'result.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
    print(json.dumps(result,ensure_ascii=False))
    return 0 if result['status']=='observed' else 1

if __name__=='__main__':raise SystemExit(main())
