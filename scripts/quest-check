#!/usr/bin/env python3
"""固定caseを指定Questの製品APKで実行し、nonce付きの診断とログを保存する。"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import time
import traceback
import zipfile

from native_build import ROOT, identity
from lifecycle_checks import stop_result
from theme_probe_checks import theme_surface_result, theme_runtime_result, theme_windows_result, theme_sdk_result
from quest_device import PACKAGE, QuestDevice, package_uid, work_root
from quest_checks import sdk_environment_result, popup_clipboard_result, compositor_layer_stats, two_windows_sdk_result, layout_sdk_result, layout_native_result, two_windows_result, resize_result, pointer_result, pointer_wire_result, keyboard_result, keyboard_wire_result, runtime_result, helper_result, surface_result, credentials_result, ssh_result, product_ssh_result, forward_result, remote_cleanup_result, native_deps_result, shm_result, wayland_state_result, waypipe_result, forwarded_shm_result, render_result, foot_result, foot_sdk_result, ray_result

CASES = ("extensions", "theme-sdk", "theme-windows", "theme-runtime", "theme-surface", "resize-native", "resize-wire", "pointer-wire", "keyboard-wire", "runtime", "helper", "surface", "pattern", "surface-cycle", "credentials", "ssh", "ssh-product", "forward", "remote-cleanup",
         "native-deps", "shm", "shm-truncate", "wayland-state", "waypipe", "forwarded-shm", "render", "foot", "ray", "keyboard",
         "pointer", "resize", "two-windows", "layout", "popup-clipboard", "stop", "reconnect", "power-lifecycle", "soak")
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--serial", required=True)
parser.add_argument("--case", required=True, choices=CASES)
parser.add_argument("--timeout", type=int, default=120)
parser.add_argument("--artifact-root", type=Path)
parser.add_argument("--instrumentation", action="store_true", help="Activityを起動しないnative検査。UI復帰は別に検査する")
args = parser.parse_args()
if args.case in {"theme-windows", "theme-runtime"} and not args.instrumentation:
    parser.error("theme-windows/theme-runtime は --instrumentation を指定してください")
if args.instrumentation and args.case not in {"theme-windows", "theme-runtime", "popup-clipboard", "layout", "two-windows", "resize-native", "resize-wire", "pointer-wire", "keyboard-wire", "foot", "render", "forward", "remote-cleanup", "native-deps", "shm", "shm-truncate", "wayland-state", "waypipe", "forwarded-shm"}:
    parser.error("instrumentationはfoot/render/forward/remote-cleanup/native-deps/shm/shm-truncate/wayland-state/waypipe/forwarded-shmだけです")
if args.case == "resize-native" and not args.instrumentation:
    parser.error("resize-nativeには--instrumentationを指定してください")
if args.case == "render" and not args.instrumentation:
    parser.error("renderの通常UI検査は未実装です。--instrumentationを指定してください")
if args.case not in {"extensions", "stop", "theme-sdk", "theme-windows", "theme-runtime", "theme-surface", "popup-clipboard", "layout", "two-windows", "resize-native", "resize", "resize-wire", "pointer", "pointer-wire", "keyboard", "keyboard-wire", "ray", "foot", "render", "runtime", "helper", "surface", "pattern", "surface-cycle", "credentials", "ssh", "ssh-product", "forward", "remote-cleanup", "native-deps", "shm", "shm-truncate", "wayland-state", "waypipe", "forwarded-shm"}:
    parser.error("このcaseは未実装です")
if not 1 <= args.timeout <= 7200:
    parser.error("timeoutは1〜7200秒です")
os.umask(0o077)
nonce = secrets.token_hex(16)
parent = args.artifact_root or work_root() / "eidolon-phase5-implementation/checks"
if not parent.is_absolute():
    parser.error("artifact rootは絶対pathにしてください")
run = parent / (datetime.datetime.now().strftime("%Y%m%dT%H%M%S") + "-" + nonce[:8])
run.mkdir(mode=0o700, parents=True)
device = QuestDevice(args.serial, run)
result = {"schema": 1, "case": args.case, "nonce": nonce, "status": "failed"}
stream = None
logfile = None
instrument = None
instrument_log = None
exit_code = 1
try:
    result.update(device.validate())
    apk_paths = device.adb("shell", "pm", "path", PACKAGE).splitlines()
    if len(apk_paths) != 1 or not re.fullmatch(r"package:/data/app/[^\s]+/base\.apk", apk_paths[0]):
        raise RuntimeError("対象APKのbase pathを一意に取得できませんでした")
    apk = run / "installed.apk"
    device.adb("pull", apk_paths[0][len("package:"):], apk, timeout=120)
    # Cargoのcache lock等のstderrを、機械判定するJSONへ混ぜない。
    with (run / "native-package.json").open("w") as output, (run / "native-package.stderr.log").open("w") as errors:
        subprocess.run(["python3", str(ROOT / "scripts/check-native-package"), "--apk", str(apk)], check=True, stdout=output, stderr=errors)
    with zipfile.ZipFile(apk) as archive:
        expected = json.loads(archive.read("assets/native-build.json"))["build_info"]
    current = identity(expected["apk_version_code"], "debug")
    if expected["profile"] != "debug" or expected["source_digest"] != current["source_digest"]:
        raise RuntimeError("導入済みAPKが現在のsourceと一致しません。build/install後に再実行してください")
    result.update(build_info=expected, apk_sha256=hashlib.sha256(apk.read_bytes()).hexdigest())
    uid = package_uid(device.adb("shell", "pm", "list", "packages", "-U", PACKAGE))
    termux_uid = package_uid(device.adb("shell", "pm", "list", "packages", "-U", "com.termux"), "com.termux") if args.case in {"extensions", "stop", "theme-sdk", "theme-windows", "layout", "two-windows", "resize-native", "resize", "pointer", "keyboard", "ssh", "ssh-product", "forward", "remote-cleanup", "forwarded-shm", "foot"} else None
    logfile = (run / "app.log").open("w")
    stream = device.start_log(uid, logfile, log_format="epoch" if args.case in {"layout","two-windows","theme-sdk"} and not args.instrumentation else "threadtime")
    if args.instrumentation:
        instrument_log = (run / "instrumentation.log").open("w")
        instrument = subprocess.Popen(["adb", "-s", args.serial, "shell", "am", "instrument", "-w", "-r", "-e", "case", args.case, "-e", "nonce", nonce, PACKAGE + "/.NativeCheckInstrumentation"], stdout=instrument_log, stderr=subprocess.STDOUT)
    else:
        # Questのimmersive appへNoDisplay Activityを挟むと起動要求が滞留することがある。
        # SDK caseはMainActivityのdebug専用・固定case/nonce検査へ直接渡す。
        sdk_cases = {"extensions", "stop", "theme-sdk", "theme-surface", "two-windows", "layout", "resize", "pointer", "keyboard", "ray", "foot", "surface", "pattern", "surface-cycle", "ssh-product"}
        activity = ".MainActivity" if args.case in sdk_cases else ".DebugCommandActivity"
        (run / "launch.log").write_text(device.adb("shell", "am", "start", "-W", "-n", PACKAGE + "/" + activity, "--es", "case", args.case, "--es", "nonce", nonce))
    deadline = time.monotonic() + args.timeout
    snapshot = None
    while time.monotonic() < deadline:
        instrument_failed = False
        if instrument is not None and instrument.poll() is not None:
            output = (run / "instrumentation.log").read_text()
            instrument_failed = instrument.returncode != 0 or not re.search(r"^INSTRUMENTATION_CODE: -1\s*$", output, re.M)
        logs = (run / "app.log").read_text()
        if re.search(r'EidolonSurface.*(?:adapter_failure_|sdk_dispose_failure_|shutdown_pose_failure_)', logs):
            raise RuntimeError("SDK adapterのlifecycle例外を検出しました")
        if "FATAL EXCEPTION" in logs or "Fatal signal" in logs:
            raise RuntimeError("対象プロセスで致命的エラーが発生しました")
        try:
            raw = device.adb("exec-out", "run-as", PACKAGE, "cat", "no_backup/diagnostics/latest.json", timeout=10)
            if len(raw.encode()) > 1024 * 1024:
                raise ValueError("snapshot上限超過")
            snapshot = json.loads(raw)
        except (RuntimeError, json.JSONDecodeError):
            if instrument_failed:
                raise RuntimeError("instrumentationが成功codeを返しませんでした")
            time.sleep(0.25)
            continue
        (run / "latest.json").write_text(json.dumps(snapshot, indent=2) + "\n")
        if instrument_failed:
            # 終了codeが失敗でも最終snapshotを保存し、直前のrunning結果を残さない。
            raise RuntimeError("instrumentationが成功codeを返しませんでした")
        if args.case in {"extensions","resize","pointer","keyboard","ray","foot"} and not args.instrumentation:
            sdk_environment_result(snapshot, nonce, expected, args.case)
        if args.case == "extensions":
            check = snapshot.get("check", {})
            accepted = sdk_environment_result(snapshot, nonce, expected, "extensions")
            if accepted and not all(check.get(key) is True for key in ["editing_return_focus", "explicit_window_focus", "input_reset", "coalesced_open", "product_settings_untouched"]):
                raise ValueError("extensionsの証拠が不足しています")
        elif args.case in {"surface", "pattern", "surface-cycle"}:
            accepted = surface_result(snapshot, nonce, expected, args.case)
        elif args.case == "resize":
            accepted = resize_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "pointer":
            accepted = pointer_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "keyboard":
            accepted = keyboard_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "pointer-wire":
            accepted = pointer_wire_result(snapshot, nonce, expected, uid, json.loads((run / "native-package.json").read_text()), instrumentation=args.instrumentation)
        elif args.case == "keyboard-wire":
            accepted = keyboard_wire_result(snapshot, nonce, expected, uid, json.loads((run / "native-package.json").read_text()), instrumentation=args.instrumentation)
        elif args.case == "popup-clipboard":
            accepted = popup_clipboard_result(snapshot, nonce, expected, uid, instrumentation=args.instrumentation)
        elif args.case == "theme-windows":
            accepted = theme_windows_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "theme-runtime":
            accepted = theme_runtime_result(snapshot, nonce, expected, uid)
        elif args.case == "stop":
            accepted = stop_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "theme-sdk":
            accepted = theme_sdk_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "theme-surface":
            accepted = theme_surface_result(snapshot, nonce, expected)
        elif args.case == "ray":
            accepted = ray_result(snapshot, nonce, expected)
        elif args.case == "layout":
            judge = layout_native_result if args.instrumentation else layout_sdk_result
            accepted = judge(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "two-windows":
            judge = two_windows_result if args.instrumentation else two_windows_sdk_result
            accepted = judge(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "resize-native":
            accepted = foot_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()), case="resize-native")
        elif args.case == "foot":
            judge = foot_result if args.instrumentation else foot_sdk_result
            accepted = judge(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()))
        elif args.case == "render":
            accepted = render_result(snapshot, nonce, expected, uid)
        elif args.case == "ssh":
            accepted = ssh_result(snapshot, nonce, expected, termux_uid)
        elif args.case == "ssh-product":
            accepted = product_ssh_result(snapshot, nonce, expected, termux_uid)
        elif args.case == "forward":
            accepted = forward_result(snapshot, nonce, expected, termux_uid, instrumentation=args.instrumentation, apk_uid=uid)
        elif args.case == "remote-cleanup":
            accepted = remote_cleanup_result(snapshot, nonce, expected, termux_uid, instrumentation=args.instrumentation, apk_uid=uid)
        elif args.case == "forwarded-shm":
            accepted = forwarded_shm_result(snapshot, nonce, expected, uid, termux_uid, json.loads((run / "native-package.json").read_text()), instrumentation=args.instrumentation)
        elif args.case == "waypipe":
            accepted = waypipe_result(snapshot, nonce, expected, uid, json.loads((run / "native-package.json").read_text())["dependencies"]["waypipe"], instrumentation=args.instrumentation)
        elif args.case in {"wayland-state", "resize-wire"}:
            accepted = wayland_state_result(snapshot, nonce, expected, uid, instrumentation=args.instrumentation, case=args.case)
        elif args.case in {"shm", "shm-truncate"}:
            accepted = shm_result(snapshot, nonce, expected, uid, args.case, instrumentation=args.instrumentation)
        elif args.case == "native-deps":
            accepted = native_deps_result(snapshot, nonce, expected, uid, json.loads((ROOT / "native/deps.lock.json").read_text()), instrumentation=args.instrumentation)
        else:
            judge = {"runtime": runtime_result, "helper": helper_result, "credentials": credentials_result}[args.case]
            accepted = judge(snapshot, nonce, expected)
        if accepted:
            if instrument is not None:
                if instrument.poll() is None:
                    time.sleep(0.25)
                    continue
                values = dict(re.findall(r"^INSTRUMENTATION_RESULT: ([a-z_]+)=(.*)$", (run / "instrumentation.log").read_text(), re.M))
                proof = snapshot["check"]["instrumentation"]
                if any(values.get(key) != value for key, value in {"case": args.case, "nonce": nonce, "result": "pass", "uid": str(uid), "pid": str(proof["pid"])}.items()):
                    raise RuntimeError("instrumentationとsnapshotのnonce/UID/PIDが不一致です")
                break
            activities = device.adb("shell", "dumpsys", "activity", "activities")
            resumed = [line for line in activities.splitlines() if "topResumedActivity=" in line or "mResumedActivity:" in line]
            if any(PACKAGE + "/.MainActivity" in line for line in resumed):
                (run / "main-return.txt").write_text("\n".join(resumed) + "\n")
                break
        time.sleep(0.25)
    else:
        raise TimeoutError("nonce/版一致したcase成功と製品runtime/UIへの復帰を確認できませんでした")
    result.update(status="pass", normal_ui_returned=not args.instrumentation, scope="native-instrumentation" if args.instrumentation else "runtime-and-ui")
    if args.case not in {"credentials", "ssh", "ssh-product", "forward", "remote-cleanup"}:
        result["cycles"] = len(snapshot["check"]["cycles"]) if args.case != "helper" else 10
    if args.case == "theme-surface":
        result.update(scope="sdk-surface-subprobe", sdk_alpha_verified=False, hmd_verified=False)
    if args.case == "runtime":
        result["panic_converted"] = True
    if args.case in {"layout","two-windows","theme-sdk"} and not args.instrumentation:
        result["compositor_layers"]=compositor_layer_stats(snapshot["check"], (run / "app.log").read_text(), uid)
    exit_code = 0
except Exception as error:
    result["error_class"] = type(error).__name__
    (run / "error.txt").write_text(traceback.format_exc())
finally:
    if instrument is not None and instrument.poll() is None:
        instrument.terminate()
        try:
            instrument.wait(timeout=5)
        except subprocess.TimeoutExpired:
            instrument.kill()
            instrument.wait()
        # observerだけ終了して、所有するinstrumentationを端末上に置き去りにしない。
        try:
            device.adb("shell", "am", "force-stop", PACKAGE)
        except Exception as error:
            # 接続喪失時も元の失敗・cleanup未完了と採取済み証拠を保存する。
            result.update(status="failed", cleanup_error_class=type(error).__name__)
            exit_code = 1
            (run / "cleanup-error.txt").write_text(traceback.format_exc())
    if instrument_log is not None:
        instrument_log.close()
    if stream is not None:
        stream.terminate()
        try:
            stream.wait(timeout=5)
        except subprocess.TimeoutExpired:
            stream.kill()
            stream.wait()
    if logfile is not None:
        logfile.close()
    (run / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({key: result[key] for key in ("case", "nonce", "status", "scope", "normal_ui_returned", "cycles", "error_class") if key in result}))
raise SystemExit(exit_code)
