#!/usr/bin/env python3
"""固定caseを指定Questの製品APKで実行し、nonce付きの診断とログを保存する。"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import time
import traceback
import zipfile

from native_build import ROOT, identity
from quest_device import PACKAGE, QuestDevice, package_uid, work_root
from quest_checks import runtime_result, helper_result, surface_result, credentials_result, ssh_result, product_ssh_result, forward_result

CASES = ("runtime", "helper", "surface", "pattern", "surface-cycle", "credentials", "ssh", "ssh-product", "forward", "remote-cleanup",
         "native-deps", "shm", "wayland-state", "waypipe", "forwarded-shm", "render", "foot", "ray", "keyboard",
         "pointer", "resize", "two-windows", "layout", "popup-clipboard", "stop", "reconnect", "power-lifecycle", "soak")
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--serial", required=True)
parser.add_argument("--case", required=True, choices=CASES)
parser.add_argument("--timeout", type=int, default=120)
parser.add_argument("--artifact-root", type=Path)
args = parser.parse_args()
if args.case not in {"runtime", "helper", "surface", "pattern", "surface-cycle", "credentials", "ssh", "ssh-product", "forward"}:
    parser.error("このcaseは未実装です")
if not 1 <= args.timeout <= 7200:
    parser.error("timeoutは1〜7200秒です")
os.umask(0o077)
nonce = secrets.token_hex(16)
parent = args.artifact_root or work_root() / "eidolon-phase5-implementation/checks"
if not parent.is_absolute():
    parser.error("artifact rootは絶対pathにしてください")
run = parent / (datetime.datetime.now().strftime("%Y%m%dT%H%M%S") + "-" + nonce[:8])
run.mkdir(mode=0o700, parents=True)
device = QuestDevice(args.serial, run)
result = {"schema": 1, "case": args.case, "nonce": nonce, "status": "failed"}
stream = None
logfile = None
exit_code = 1
try:
    result.update(device.validate())
    apk_paths = device.adb("shell", "pm", "path", PACKAGE).splitlines()
    if len(apk_paths) != 1 or not re.fullmatch(r"package:/data/app/[^\s]+/base\.apk", apk_paths[0]):
        raise RuntimeError("対象APKのbase pathを一意に取得できませんでした")
    apk = run / "installed.apk"
    device.adb("pull", apk_paths[0][len("package:"):], apk, timeout=120)
    with (run / "native-package.json").open("w") as output:
        subprocess.run(["python3", str(ROOT / "scripts/check-native-package"), "--apk", str(apk)], check=True, stdout=output, stderr=subprocess.STDOUT)
    with zipfile.ZipFile(apk) as archive:
        expected = json.loads(archive.read("assets/native-build.json"))["build_info"]
    current = identity(expected["apk_version_code"], "debug")
    if expected["profile"] != "debug" or expected["source_digest"] != current["source_digest"]:
        raise RuntimeError("導入済みAPKが現在のsourceと一致しません。build/install後に再実行してください")
    result.update(build_info=expected, apk_sha256=hashlib.sha256(apk.read_bytes()).hexdigest())
    uid = package_uid(device.adb("shell", "pm", "list", "packages", "-U", PACKAGE))
    termux_uid = package_uid(device.adb("shell", "pm", "list", "packages", "-U", "com.termux"), "com.termux") if args.case in {"ssh", "ssh-product", "forward"} else None
    logfile = (run / "app.log").open("w")
    stream = device.start_log(uid, logfile)
    (run / "launch.log").write_text(device.adb("shell", "am", "start", "-n", PACKAGE + "/.DebugCommandActivity", "--es", "case", args.case, "--es", "nonce", nonce))
    deadline = time.monotonic() + args.timeout
    snapshot = None
    while time.monotonic() < deadline:
        logs = (run / "app.log").read_text()
        if "FATAL EXCEPTION" in logs or "Fatal signal" in logs:
            raise RuntimeError("対象プロセスで致命的エラーが発生しました")
        try:
            raw = device.adb("exec-out", "run-as", PACKAGE, "cat", "no_backup/diagnostics/latest.json", timeout=10)
            if len(raw.encode()) > 1024 * 1024:
                raise ValueError("snapshot上限超過")
            snapshot = json.loads(raw)
        except (RuntimeError, json.JSONDecodeError):
            time.sleep(0.25)
            continue
        (run / "latest.json").write_text(json.dumps(snapshot, indent=2) + "\n")
        if args.case in {"surface", "pattern", "surface-cycle"}:
            accepted = surface_result(snapshot, nonce, expected, args.case)
        elif args.case == "ssh":
            accepted = ssh_result(snapshot, nonce, expected, termux_uid)
        elif args.case == "ssh-product":
            accepted = product_ssh_result(snapshot, nonce, expected, termux_uid)
        elif args.case == "forward":
            accepted = forward_result(snapshot, nonce, expected, termux_uid)
        else:
            judge = {"runtime": runtime_result, "helper": helper_result, "credentials": credentials_result}[args.case]
            accepted = judge(snapshot, nonce, expected)
        if accepted:
            activities = device.adb("shell", "dumpsys", "activity", "activities")
            resumed = [line for line in activities.splitlines() if "topResumedActivity=" in line or "mResumedActivity:" in line]
            if any(PACKAGE + "/.MainActivity" in line for line in resumed):
                (run / "main-return.txt").write_text("\n".join(resumed) + "\n")
                break
        time.sleep(0.25)
    else:
        raise TimeoutError("nonce/版一致したcase成功と製品runtime/UIへの復帰を確認できませんでした")
    result.update(status="pass", normal_ui_returned=True)
    if args.case not in {"credentials", "ssh", "ssh-product", "forward"}:
        result["cycles"] = len(snapshot["check"]["cycles"]) if args.case != "helper" else 10
    if args.case == "runtime":
        result["panic_converted"] = True
    exit_code = 0
except Exception as error:
    result["error_class"] = type(error).__name__
    (run / "error.txt").write_text(traceback.format_exc())
finally:
    if stream is not None:
        stream.terminate()
        try:
            stream.wait(timeout=5)
        except subprocess.TimeoutExpired:
            stream.kill()
            stream.wait()
    if logfile is not None:
        logfile.close()
    (run / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({key: result[key] for key in ("case", "nonce", "status", "cycles", "error_class") if key in result}))
raise SystemExit(exit_code)
