#!/usr/bin/env python3
"""Quest/Termuxの固定短命子だけでptrace/3 hardware slot能力を一回確認する。"""
import argparse
import base64
import datetime
import hashlib
import json
import os
from pathlib import Path
import secrets
import selectors
import shlex
import subprocess
import time
import zlib
from native_build import ROOT
from quest_device import QuestDevice,package_uid,work_root
from sdl_probe_install import InstallError,canonical,require,unique_object
from ptrace_capability_probe import OPERATOR,UID,EXPECTED_EXIT,REASONS,receipt

SOURCES=("scripts/sdl_probe_install.py","scripts/ptrace_capability_probe.py","scripts/quest-probe-ptrace-capability")


def source_hashes():return {p:hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in SOURCES}


def remote_program():
    source="import sys,types\n"
    for name,path in zip(("sdl_probe_install","ptrace_probe"),SOURCES[:2]):
        source+=f"m=types.ModuleType({name!r});exec({(ROOT/path).read_text()!r},m.__dict__);sys.modules[m.__name__]=m\n"
    child=source+"raise SystemExit(sys.modules['ptrace_probe'].child_main())\n"
    return source+f"sys.modules['ptrace_probe'].CHILD_SOURCE={child!r}\nraise SystemExit(sys.modules['ptrace_probe'].remote_main())\n"


def remote_source():
    data=base64.b64encode(zlib.compress(remote_program().encode(),9)).decode()
    return f"import base64,zlib;exec(zlib.decompress(base64.b64decode({data!r})))"


def validated_result(value,probe_id):
    fields={"status","reason","errno","architecture","child_pid","child_group","child_returncode","expected_exit","termination","stop_observed",
        "exitkill_set","continue_sent","regset","term_sent","term_forwarded","kill_sent","timed_out","reaped","group_reclaimed","pipes_drained",
        "cleanup_confirmed","output_bytes","traceme","continued_receipt","egl","drawing","schema","operator","probe_id","uid"}
    require(type(value) is dict and set(value)==fields and type(value["schema"]) is int and value["schema"]==1 and value["operator"]==OPERATOR and value["probe_id"]==probe_id and value["uid"]==UID,"REMOTE_RESULT_INVALID")
    require(value["status"] in {"supported","unsupported"} and value["reason"] in REASONS|{None} and value["architecture"] in {"aarch64","unsupported"} and
        value["egl"]==value["drawing"]=="not_run" and value["expected_exit"]==EXPECTED_EXIT,"REMOTE_RESULT_INVALID")
    for key in ("stop_observed","exitkill_set","continue_sent","term_sent","term_forwarded","kill_sent","timed_out","reaped","group_reclaimed","pipes_drained","cleanup_confirmed"):
        require(type(value[key]) is bool,"REMOTE_RESULT_INVALID")
    require(type(value["child_pid"]) is int and 0<value["child_pid"]<2**31 and value["child_group"]==value["child_pid"] and
        (value["errno"] is None or type(value["errno"]) is int and 0<=value["errno"]<=4095) and
        (value["child_returncode"] is None or type(value["child_returncode"]) is int and -255<=value["child_returncode"]<=255),"REMOTE_RESULT_INVALID")
    require(value["termination"]==("unreaped" if value["child_returncode"] is None else "signal" if value["child_returncode"]<0 else "natural"),"REMOTE_RESULT_INVALID")
    require(type(value["output_bytes"]) is dict and set(value["output_bytes"])=={"stdout","stderr"} and all(type(v) is int and 0<=v<2**63 for v in value["output_bytes"].values()),"REMOTE_RESULT_INVALID")
    if value["regset"] is not None:
        r=value["regset"];require(type(r) is dict and set(r)=={"gpr_bytes","hardware_bytes","hardware_slots","debug_arch","state_clean"} and
            r["gpr_bytes"]==272 and r["hardware_bytes"]==264 and type(r["hardware_slots"]) is int and 0<=r["hardware_slots"]<=16 and
            type(r["debug_arch"]) is int and 0<=r["debug_arch"]<=255 and type(r["state_clean"]) is bool,"REMOTE_RESULT_INVALID")
    for key in ("traceme","continued_receipt"):
        if value[key] is not None:receipt(canonical(value[key]),value["child_pid"],probe_id,UID)
    if value["status"]=="supported":
        require(value["reason"] is None and value["regset"] is not None and value["regset"]["hardware_slots"]>=3 and value["regset"]["state_clean"] and value["architecture"]=="aarch64" and
            value["stop_observed"] and value["exitkill_set"] and value["continue_sent"] and value["cleanup_confirmed"] and
            value["reaped"] and value["group_reclaimed"] and value["pipes_drained"] and value["child_returncode"]==EXPECTED_EXIT and
            value["traceme"] is not None and value["traceme"]["success"] and value["continued_receipt"] is not None and
            not any(value[k] for k in ("term_sent","kill_sent","timed_out")),"REMOTE_RESULT_INVALID")
    else:require(value["reason"] in REASONS,"REMOTE_RESULT_INVALID")
    return value


def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument("--serial",required=True);parser.add_argument("--artifact-root",type=Path)
    args=parser.parse_args();os.umask(0o077);root=args.artifact_root or work_root()/"eidolon-ptrace-capability"
    if not root.is_absolute():parser.error("artifact rootは絶対pathです")
    nonce=secrets.token_hex(16);run=root/(datetime.datetime.now().strftime("%Y%m%dT%H%M%S-%f")+"-"+nonce);run.mkdir(mode=0o700,parents=True)
    result=dict(schema=1,operator=OPERATOR,probe_id=nonce,status="unsupported",egl="not_run",drawing="not_run")
    child=selector=None;sent=False
    def close_input():
        if child is not None and not child.stdin.closed:
            try:child.stdin.close()
            except (OSError,ValueError):pass
    def cancel():
        nonlocal sent
        if child is not None and not sent and not child.stdin.closed:
            try:child.stdin.write(b'{"type":"cancel"}\n');child.stdin.flush();sent=True
            except (OSError,ValueError):pass
    try:
        device=QuestDevice(args.serial,run);result["device"]=device.validate()
        require(package_uid(device.adb("shell","pm","list","packages","-U","com.termux"),"com.termux")==UID,"UID_MISMATCH")
        pins=source_hashes();source=remote_source();command=shlex.join(["run-as","com.termux","/data/data/com.termux/files/usr/bin/python3","-c",source])
        require(len(command.encode())<=49*1024,"REMOTE_COMMAND_LIMIT");result.update(source_sha256=pins,remote_command_bytes=len(command.encode()))
        child=subprocess.Popen(["adb","-s",args.serial,"shell","-T",command],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        child.stdin.write(canonical(dict(probe_id=nonce))+b"\n");child.stdin.flush()
        selector=selectors.DefaultSelector()
        for name in ("stdout","stderr"):
            pipe=getattr(child,name);os.set_blocking(pipe.fileno(),False);selector.register(pipe,selectors.EVENT_READ,name)
        started=time.monotonic();pending=bytearray();sizes=dict(stdout=0,stderr=0);finished=None;terminal_seen=False
        while time.monotonic()-started<20:
            for key,_ in selector.select(.03):
                data=os.read(key.fd,8192)
                if not data:selector.unregister(key.fd);continue
                sizes[key.data]+=len(data)
                if key.data=="stderr":
                    if sizes["stderr"]>65536:cancel()
                    continue
                require(sizes["stdout"]<=65536,"REMOTE_OUTPUT_INVALID");pending.extend(data)
                while b"\n" in pending:
                    line,_,rest=pending.partition(b"\n");pending=bytearray(rest);event=json.loads(line,object_pairs_hook=unique_object)
                    require(type(event) is dict and event.get("phase") in {"finished","blocked"} and not terminal_seen,"REMOTE_OUTPUT_INVALID")
                    terminal_seen=True
                    if event["phase"]=="finished":
                        require(set(event)=={"phase","result"} and finished is None,"REMOTE_OUTPUT_INVALID")
                        finished=validated_result(event["result"],nonce);close_input()
                    else:
                        require(set(event)=={"phase","status","reason"} and event["status"]=="unsupported" and event["reason"] in REASONS,"REMOTE_OUTPUT_INVALID")
                        result["reason"]=event["reason"];close_input()
            if child.poll() is not None and not selector.get_map():break
        if child.poll() is None:cancel()
        close_input();child.wait(timeout=6)
        result.update(remote_result=finished,remote_returncode=child.returncode,output_bytes=sizes)
        require(not pending and source_hashes()==pins,"SOURCE_CHANGED_OR_OUTPUT_INVALID")
        require(terminal_seen,"REMOTE_OUTPUT_INVALID")
        if finished and finished["status"]=="supported" and child.returncode==0:result["status"]="supported"
    except (OSError,ValueError,TypeError,KeyError,RuntimeError,subprocess.SubprocessError) as error:
        result["reason"]=str(error) if isinstance(error,InstallError) and str(error) in REASONS|{"REMOTE_COMMAND_LIMIT","REMOTE_OUTPUT_INVALID","REMOTE_RESULT_INVALID","SOURCE_CHANGED_OR_OUTPUT_INVALID"} else "OPERATOR_UNAVAILABLE";cancel()
    finally:
        if child is not None:
            close_input()
            try:child.wait(timeout=6)
            except (OSError,subprocess.SubprocessError):
                result["remote_cleanup_unconfirmed"]=True;child.terminate()
                try:child.wait(timeout=2)
                except (OSError,subprocess.SubprocessError):pass
            result.setdefault("remote_returncode",child.returncode);child.stdout.close();child.stderr.close()
        if selector is not None:selector.close()
        (run/"result.json").write_text(json.dumps(result,indent=2)+"\n")
    print(json.dumps(dict(status=result["status"],artifact=str(run),probe_id=nonce,reason=result.get("reason") or (result.get("remote_result") or {}).get("reason"),egl="not_run")))
    return 0 if result["status"]=="supported" else 2


if __name__=="__main__":raise SystemExit(main())
