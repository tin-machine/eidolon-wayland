#!/usr/bin/env python3
"""実Waypipeを挟んでclipboardの上限・FD回収と仲介bufferの差を観測するhost検査。"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
from native_build import ROOT
from quest_device import work_root

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--artifact-root',type=Path)
args=parser.parse_args()
os.umask(0o077)
parent=args.artifact_root or work_root()/'eidolon-phase5-implementation/waypipe-clipboard'
if not parent.is_absolute():parser.error('artifact rootは絶対pathにしてください')
run=parent/(datetime.datetime.now().strftime('%Y%m%dT%H%M%S')+'-'+str(os.getpid()))
run.mkdir(mode=0o700,parents=True)
metadata=json.loads((ROOT/'native/generated/waypipe-host.json').read_text())
binary=Path(metadata['executable'])
if (metadata.get('target')!='host' or metadata.get('version')!='0.11.3'
        or hashlib.sha256(binary.read_bytes()).hexdigest()!=metadata.get('sha256')):
    raise SystemExit('現在のscripts/build-waypipe --target hostを先に実行してください')
argv=['cargo','+1.95.0','run','--locked','--offline','--manifest-path',str(ROOT/'scripts/fixtures/clipboard-waypipe/Cargo.toml'),
      '--target-dir',str(ROOT/'target'),'--',str(ROOT),str(run)]
(run/'command.json').write_text(json.dumps(argv,ensure_ascii=False,indent=2)+'\n')
with (run/'build-and-run.log').open('w') as log:
    subprocess.run(argv,cwd=ROOT,check=True,stdout=log,stderr=subprocess.STDOUT,timeout=600)
result=json.loads((run/'result.json').read_text())
if result.get('status') not in {'observed_intermediary_buffering','observed_core_backpressure'} or result.get('core_bounds_verified') is not True:
    raise SystemExit('Waypipe経由のclipboardの証拠が不正です')
print(json.dumps({'artifact':str(run),'status':result['status'],'core_bounds_verified':True,'end_to_end_timeout_verified':False},ensure_ascii=False))
