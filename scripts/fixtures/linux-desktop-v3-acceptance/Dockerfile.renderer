# This disposable image produces renderer T evidence only, never N02/I6 PASS.
FROM ubuntu:24.04
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN timeout --signal=TERM --kill-after=5s 90s \
      apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=10 \
      -o Acquire::https::Timeout=10 -o APT::Update::Error-Mode=any update \
    && DEBIAN_FRONTEND=noninteractive timeout --signal=TERM --kill-after=5s 240s \
      apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=10 \
      -o Acquire::https::Timeout=10 install -y --no-install-recommends \
      ca-certificates curl git python3 python3-pip python3-venv build-essential \
      pkg-config ninja-build bison perl patch cmake libegl1 libegl-mesa0 libgles2 \
      libgl1-mesa-dri passwd \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 12001 --create-home --home-dir /home/eidolon-driver \
      --shell /bin/bash eidolon-driver \
    && install -d -m 0755 -o eidolon-driver -g eidolon-driver /src \
    && install -d -m 0700 -o eidolon-driver -g eidolon-driver /artifacts
COPY --chown=12001:12001 . /src
USER eidolon-driver
WORKDIR /src
ENV PATH="/home/eidolon-driver/.cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 \
      --connect-timeout 10 --max-time 120 https://sh.rustup.rs \
      --output /tmp/eidolon-renderer-rustup.sh \
    && sh /tmp/eidolon-renderer-rustup.sh -y --profile minimal \
      --default-toolchain 1.95.0 --no-modify-path \
    && rm /tmp/eidolon-renderer-rustup.sh
RUN export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe EGL_PLATFORM=surfaceless \
    && python3 scripts/build-native-deps --target host \
    && cargo +1.95.0 test --locked -p eidolon-render \
    && cargo +1.95.0 test --locked -p eidolon-render --features host-acceptance \
    && cargo +1.95.0 test --locked -p eidolon-core --features host-acceptance --lib host_readback \
    && cargo +1.95.0 test --locked \
      --manifest-path scripts/fixtures/linux-real-app-v3-renderer/Cargo.toml \
      --target-dir /src/target \
    && cargo +1.95.0 build --locked \
      --manifest-path scripts/fixtures/linux-real-app-v3-renderer/Cargo.toml \
      --target-dir /src/target
USER root
RUN install -d -m 0755 /opt/i6 \
    && install -m 0555 /src/target/debug/eidolon-i6-renderer-host /opt/i6/eidolon-i6-renderer-host \
    && chmod -R a+rX,go-w /src
USER eidolon-driver
ENV PATH="/usr/bin:/bin"
ENTRYPOINT ["python3", "/src/scripts/linux_real_app_v3_renderer.py", "--source-root", "/src", "--runner", "/opt/i6/eidolon-i6-renderer-host", "--artifact-root", "/artifacts"]
CMD []
