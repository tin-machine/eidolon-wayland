# This image is only a disposable N01 fixture, not a product distribution.
# Its actual image ID is recorded by check-linux-desktop-v3-n01. The Ubuntu
# tag is not presented as a reviewed immutable environment/golden fingerprint.
FROM ubuntu:24.04

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Root installs packages only inside this build container. Preserve APT's
# signature checks and bound both network retries and the complete operation.
RUN timeout --signal=TERM --kill-after=5s 90s \
      apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=10 \
      -o Acquire::https::Timeout=10 -o APT::Update::Error-Mode=any update \
    && DEBIAN_FRONTEND=noninteractive timeout --signal=TERM --kill-after=5s 240s \
      apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=10 \
      -o Acquire::https::Timeout=10 install -y --no-install-recommends \
      ca-certificates curl git python3 python3-pip python3-venv \
      build-essential autoconf automake libtool gettext autopoint xfce4-dev-tools \
      libgtk-3-dev libgtksourceview-4-dev pkg-config dbus ninja-build bison perl \
      patch cmake openssh-server passwd util-linux libegl1 libgles2 \
    && rm -rf /var/lib/apt/lists/*

# Compilation has its own account. The driver and app accounts/HOMEs do not
# exist in the image and are created fresh by the runtime supervisor.
RUN useradd --uid 11000 --create-home --home-dir /home/eidolon-build \
      --shell /bin/bash eidolon-build \
    && install -d -m 0755 -o eidolon-build -g eidolon-build /src
COPY --chown=11000:11000 . /src
USER eidolon-build
WORKDIR /src
ENV PATH="/home/eidolon-build/.cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 \
      --connect-timeout 10 --max-time 120 https://sh.rustup.rs \
      --output /tmp/eidolon-i6-rustup.sh \
    && sh /tmp/eidolon-i6-rustup.sh -y --profile minimal \
      --default-toolchain 1.95.0 --no-modify-path \
    && rm /tmp/eidolon-i6-rustup.sh \
    && rustc +1.95.0 --version

# Reuse unchanged source-pinned builders. The runtime has no external network.
RUN python3 scripts/build-native-deps --target host \
    && python3 scripts/build-waypipe --target host \
    && cargo +1.95.0 build --locked -p eidolon-shm-fixture --bin eidolon-shm-fixture \
    && cargo +1.95.0 test --locked -p eidolon-transport \
      --features host-acceptance host_acceptance \
    && if ! cargo +1.95.0 metadata --locked --format-version 1 \
      --manifest-path scripts/fixtures/linux-real-app-v3-host/Cargo.toml \
      >/tmp/n01-metadata.json; then \
        cp scripts/fixtures/linux-real-app-v3-host/Cargo.lock /tmp/n01-Cargo.lock.expected; \
        cargo +1.95.0 metadata --offline --format-version 1 \
          --manifest-path scripts/fixtures/linux-real-app-v3-host/Cargo.toml \
          >/tmp/n01-metadata.json || true; \
        diff -u /tmp/n01-Cargo.lock.expected \
          scripts/fixtures/linux-real-app-v3-host/Cargo.lock >&2 || true; \
        exit 1; \
      fi \
    && cargo +1.95.0 test --locked \
      --manifest-path scripts/fixtures/linux-real-app-v3-host/Cargo.toml \
      --target-dir /src/target \
    && cargo +1.95.0 build --locked \
      --manifest-path scripts/fixtures/linux-real-app-v3-host/Cargo.toml \
      --target-dir /src/target

RUN python3 scripts/ci/prepare-linux-real-app-fixture --stage build \
      --work-directory /home/eidolon-build/mousepad-a0 --isolated-container

USER root
RUN dpkg --install /home/eidolon-build/mousepad-a0/mousepad-a0.deb \
    && ldconfig \
    && glib-compile-schemas --strict /usr/share/glib-2.0/schemas \
    && runuser -u eidolon-build -- python3 scripts/ci/prepare-linux-real-app-fixture \
      --stage inventory --work-directory /home/eidolon-build/mousepad-a0 \
      --isolated-container \
    && install -d -m 0755 /opt/i6 \
    && install -m 0555 /src/target/debug/eidolon-i6-n01-host /opt/i6/eidolon-i6-host \
    && install -m 0444 /home/eidolon-build/mousepad-a0/reviewed-package.json \
      /opt/i6/reviewed-package.json \
    && chown -R root:root /src \
    && chmod -R a+rX,go-w /src

# There are no host mounts or persistent test identities. The supervisor owns
# provisioning/sshd only; product Registry and C2 run as distinct nonroot users.
ENTRYPOINT ["python3", "/src/scripts/linux_real_app_v3_n01.py", "--disposable-container", "--source-root", "/src", "--fixture-root", "/run/eidolon-i6", "--reviewed-package", "/opt/i6/reviewed-package.json", "--runner", "/opt/i6/eidolon-i6-host", "--artifact-root", "/artifacts"]
