#!/usr/bin/python3
"""既存Linux private base bundleへ固定GTK C/binary/manifestを排他的に追加する。実行・SSH操作なし。"""
import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import selectors
import shlex
import stat
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location('linux_helper', ROOT / 'scripts/linux/eidolon-linux-session.py')
helper = importlib.util.module_from_spec(spec); spec.loader.exec_module(helper)
SOURCE = ROOT / 'scripts/fixtures/gtk3-interaction-fixture.c'


def trusted_tool(path):
    actual = Path(path).resolve(strict=True)
    for item in (Path(path), actual, *actual.parents):
        info = item.lstat()
        helper.require(info.st_uid == 0 and (stat.S_ISLNK(info.st_mode) or not info.st_mode & 0o022), 'BUILD_TOOL_UNTRUSTED')
    helper.require(actual.is_file() and os.access(actual, os.X_OK), 'BUILD_TOOL_UNTRUSTED')
    return path


def command(argv, environment, seconds=5, capture=False):
    group = helper.Group(argv, environment); selector = selectors.DefaultSelector()
    output = bytearray(); counts = dict(stdout=0, stderr=0); complete = False
    try:
        for name in counts:
            pipe = getattr(group.child, name); os.set_blocking(pipe.fileno(), False); selector.register(pipe, selectors.EVENT_READ, name)
        deadline = time.monotonic() + seconds
        while selector.get_map() or not group.exited():
            helper.require(time.monotonic() < deadline, 'BUILD_TIMEOUT')
            for key, _ in selector.select(.02):
                data = os.read(key.fd, 8192)
                if not data: selector.unregister(key.fd); continue
                counts[key.data] += len(data)
                helper.require(sum(counts.values()) <= 1048576, 'BUILD_OUTPUT_LIMIT')
                if capture and key.data == 'stdout':
                    output.extend(data); helper.require(len(output) <= 16384, 'BUILD_OUTPUT_LIMIT')
        helper.require(os.waitid(os.P_PID, group.child.pid, os.WEXITED | os.WNOWAIT).si_status == 0, 'BUILD_TOOL_FAILED')
        complete = True
    finally:
        reclaimed = group.finish(); selector.close(); group.child.stdout.close(); group.child.stderr.close()
        helper.require(reclaimed, 'BUILD_CLEANUP_PENDING')
    helper.require(complete, 'BUILD_TOOL_FAILED')
    return bytes(output), counts


def exclusive_file(path, data, mode):
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    with os.fdopen(descriptor, 'wb') as stream:
        stream.write(data); stream.flush(); os.fsync(stream.fileno())


def build(directory):
    helper.require(sys.platform == 'linux' and os.getuid() == os.geteuid() != 0 and directory.is_absolute() and
                   directory.resolve() == directory and directory.parts[-3:] == ('.local', 'lib', 'eidolon-linux'), 'BUILD_LOCATION_INVALID')
    home = directory.parents[2]; helper.checked_directory(home, private=False)
    verified, _, base_hash = helper.bundle(home); helper.require(verified == directory, 'BUILD_LOCATION_INVALID')
    for name in (*helper.GTK_FILES, 'gtk-bundle.json', 'gtk-build'):
        helper.require(not os.path.lexists(directory / name), 'BUILD_ALREADY_EXISTS')
    source = SOURCE.read_bytes(); source_hash = hashlib.sha256(source).hexdigest()
    helper.require(0 < len(source) <= 65536, 'BUILD_SOURCE_INVALID')
    cc, pkg = trusted_tool('/usr/bin/cc'), trusted_tool('/usr/bin/pkg-config')
    scratch = directory / 'gtk-build'; scratch.mkdir(mode=0o700)
    environment = {'PATH': '/usr/bin:/bin', 'HOME': str(scratch), 'TMPDIR': str(scratch), 'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8'}
    version = command([pkg, '--modversion', 'gtk+-3.0'], environment, capture=True)[0].decode('ascii').strip()
    helper.require(re.fullmatch(r'3\.24\.[0-9]{1,3}', version), 'GTK_VERSION_UNSUPPORTED')
    flags = shlex.split(command([pkg, '--cflags', '--libs', 'gtk+-3.0'], environment, capture=True)[0].decode('ascii'))
    helper.require(flags and all(flag.startswith(('-I', '-L', '-l', '-D', '-pthread', '-Wl,')) and
                   'EIDOLON_GTK_FIXTURE_SELFTEST' not in flag for flag in flags), 'GTK_FLAGS_INVALID')
    fixed_source = scratch / helper.GTK_FILES[0]; exclusive_file(fixed_source, source, 0o600)
    target = scratch / helper.GTK_FILES[1]
    _, counts = command([cc, '-std=c11', '-Wall', '-Wextra', '-Werror', '-O2', str(fixed_source), '-o', str(target), *flags], environment, seconds=30)
    target.chmod(0o700); binary = helper.private_read(target, 4 * 1024 * 1024, executable=True)
    helper.require(binary[:6] == b'\x7fELF\x02\x01' and len(binary) >= 64, 'BUILD_BINARY_INVALID')
    helper.require(SOURCE.read_bytes() == source and fixed_source.read_bytes() == source and helper.bundle(home)[2] == base_hash, 'BUILD_INPUT_CHANGED')
    hashes = {helper.GTK_FILES[0]: source_hash, helper.GTK_FILES[1]: hashlib.sha256(binary).hexdigest()}
    manifest = dict(schema=1, backend='linux_posix', revision=helper.GTK_REVISION, base_bundle_sha256=base_hash,
                    gtk_version=version, files=hashes)
    exclusive_file(directory / helper.GTK_FILES[0], source, 0o600)
    exclusive_file(directory / helper.GTK_FILES[1], binary, 0o700)
    helper.write_record(directory / 'gtk-bundle.json', manifest, replace=False)
    result = dict(schema=1, status='built', executed=False, source_sha256=source_hash, binary_sha256=hashes[helper.GTK_FILES[1]],
                  gtk_bundle_sha256=helper.gtk_bundle(home)[4], base_bundle_sha256=base_hash,
                  gtk_version=version, compiler_output_bytes=counts, compiler_reaped=True)
    helper.write_record(scratch / 'build.json', result, replace=False)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('--bundle-directory', type=Path, required=True)
    arguments = parser.parse_args(); os.umask(0o077)
    try: result = build(arguments.bundle_directory)
    except (OSError, ValueError, TypeError, KeyError, UnicodeError) as error:
        fixed = str(error)
        result = dict(schema=1, status='failed', executed=False,
                      reason=fixed if re.fullmatch(r'(BUILD|GTK|BUNDLE|HELPER|FILE|DIRECTORY)_[A-Z_]{1,48}', fixed) else 'BUILD_UNAVAILABLE')
    print(json.dumps(result, separators=(',', ':')))
    return 0 if result['status'] == 'built' else 1


if __name__ == '__main__': raise SystemExit(main())
