#!/usr/bin/env python3
"""公式Freedoomの固定pinを検査し、専用assets/固定case計画だけをhostへ準備する。"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import secrets
import stat
from freedoom_probe_prepare import prepare,PrepareError
from quest_device import work_root


def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument("--archive",type=Path,required=True);parser.add_argument("--artifact-root",type=Path)
    args=parser.parse_args();os.umask(0o077);root=args.artifact_root or work_root()/"eidolon-freedoom-prepared"
    if not root.is_absolute():parser.error("artifact rootは絶対pathです")
    root.mkdir(mode=0o700,parents=True,exist_ok=True)
    info=root.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid!=os.getuid() or stat.S_IMODE(info.st_mode)!=0o700:parser.error("artifact rootが安全な所有directoryではありません")
    run_id=secrets.token_hex(16);directory=root/(datetime.datetime.now().strftime("%Y%m%dT%H%M%S-%f")+"-"+run_id)
    try:
        prepare(args.archive,directory,run_id)
        sha=hashlib.sha256((directory/"manifest.json").read_bytes()).hexdigest()
        print(json.dumps(dict(status="prepared",run_id=run_id,artifact=str(directory),manifest_sha256=sha,execution="not_run",catalog="not_modified")))
        return 0
    except (OSError,ValueError,TypeError) as error:
        reason=str(error) if isinstance(error,PrepareError) else "PREPARE_IO_FAILED"
        print(json.dumps(dict(status="failed",reason=reason,run_id=run_id,execution="not_run",catalog="not_modified")))
        return 1


if __name__=="__main__":raise SystemExit(main())
