#!/usr/bin/env python3
"""指定Questのdebug Termuxへ固定launcherだけを配備し、転送前後のSHA256を照合する。"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess

from quest_device import QuestDevice, work_root

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--serial", required=True)
parser.add_argument("--artifact-root", type=Path)
args = parser.parse_args()
os.umask(0o077)
root = args.artifact_root or work_root() / "eidolon-phase5-implementation/launcher-install"
if not root.is_absolute():
    parser.error("artifact rootは絶対pathにしてください")
run = root / (datetime.datetime.now().strftime("%Y%m%dT%H%M%S") + f"-{os.getpid()}")
run.mkdir(parents=True, mode=0o700)
device = QuestDevice(args.serial, run)
device.validate()
source = (Path(__file__).resolve().parent / "termux/eidolon-session.py").read_bytes()
expected = hashlib.sha256(source).hexdigest()
# ADBで渡すのは固定配布物のみ。APKの秘密鍵や既存の認証fileには触れない。
installer = r'''
import hashlib,json,os,pathlib,stat,sys,tempfile
os.umask(0o077)
data=sys.stdin.buffer.read(131073)
assert len(data)<=131072 and hashlib.sha256(data).hexdigest()==sys.argv[1]
home=pathlib.Path('/data/data/com.termux/files/home')
directory=home
for part in ['.local','lib','eidolon']:
    directory=directory/part
    try: directory.mkdir(mode=0o700)
    except FileExistsError: pass
    info=directory.lstat()
    assert stat.S_ISDIR(info.st_mode) and info.st_uid==os.getuid() and not info.st_mode&0o022
target=directory/'eidolon-session.py'
if target.exists() or target.is_symlink():
    info=target.lstat()
    assert stat.S_ISREG(info.st_mode) and info.st_uid==os.getuid()
fd,name=tempfile.mkstemp(prefix='.session-',dir=directory)
try:
    with os.fdopen(fd,'wb') as out:
        out.write(data);out.flush();os.fsync(out.fileno())
    os.chmod(name,0o700);os.replace(name,target)
finally:
    if os.path.exists(name):os.unlink(name)
assert hashlib.sha256(target.read_bytes()).hexdigest()==sys.argv[1]
print(json.dumps({'status':'pass','sha256':sys.argv[1],'python':sys.version.split()[0]}))
'''
command = ["run-as", "com.termux", "/data/data/com.termux/files/usr/bin/python3", "-c", installer, expected]
process = subprocess.run(["adb", "-s", args.serial, "shell", "-T", shlex.join(command)], input=source, capture_output=True, timeout=30)
(run / "installer.log").write_bytes(process.stdout + process.stderr)
if process.returncode:
    raise SystemExit("launcher配備失敗。保存したinstaller.logを確認してください")
result = json.loads(process.stdout)
if result.get("status") != "pass" or result.get("sha256") != expected:
    raise SystemExit("launcher照合失敗")
(run / "result.json").write_text(json.dumps(result, indent=2) + "\n")
print(json.dumps(result))
