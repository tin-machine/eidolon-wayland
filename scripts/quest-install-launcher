#!/usr/bin/env python3
"""固定helper/GUI worker/owner bundleを配備し、前後のhash鎖を照合する。"""
import argparse
import base64
import datetime
import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess
import zlib
from native_build import ROOT
from quest_device import QuestDevice,work_root
import launcher_bundle as bundle


def source_hashes():
    paths=['scripts/quest-install-launcher','scripts/launcher_bundle.py','scripts/sdl_probe_install.py',*['scripts/termux/'+name for name in bundle.FILES]]
    return {name:hashlib.sha256((ROOT/name).read_bytes()).hexdigest() for name in paths}


def remote_source():
    source="import sys,types\n"
    for name in ('sdl_probe_install','launcher_bundle'):
        data=(ROOT/('scripts/'+name+'.py')).read_text()
        source+=f"m=types.ModuleType({name!r});sys.modules[m.__name__]=m;exec({data!r},m.__dict__)\n"
    source+="raise SystemExit(sys.modules['launcher_bundle'].remote_main())\n"
    encoded=base64.b64encode(zlib.compress(source.encode(),9)).decode()
    return f"import base64,zlib;exec(zlib.decompress(base64.b64decode({encoded!r})))"


def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--serial',required=True);parser.add_argument('--artifact-root',type=Path)
    args=parser.parse_args();os.umask(0o077);root=args.artifact_root or work_root()/'eidolon-phase5-implementation/launcher-install'
    if not root.is_absolute():parser.error('artifact rootは絶対pathです')
    run=root/(datetime.datetime.now().strftime('%Y%m%dT%H%M%S-%f')+'-'+str(os.getpid()));run.mkdir(parents=True,mode=0o700)
    result=dict(status='fail',error=None)
    try:
        device=QuestDevice(args.serial,run);result['device']=device.validate();pins=source_hashes()
        wire,manifest=bundle.prepare(ROOT);pin=bundle.sha(wire)
        command=shlex.join(['run-as','com.termux','/data/data/com.termux/files/usr/bin/python3','-c',remote_source(),pin])
        if len(command.encode())>49*1024:raise ValueError('REMOTE_COMMAND_LIMIT')
        process=subprocess.run(['adb','-s',args.serial,'shell','-T',command],input=wire,capture_output=True,timeout=30)
        result.update(returncode=process.returncode,stdout_bytes=len(process.stdout),stderr_bytes=len(process.stderr),bundle_bytes=len(wire),bundle_sha256=pin,source_sha256=pins)
        report=json.loads(process.stdout) if len(process.stdout)<=4096 else None
        expected=dict(status='pass',sha256=manifest['files']['eidolon-session.py']['sha256'],files=manifest['files'],bundle_sha256=pin)
        if not (type(report) is dict and set(report)==set(expected)|{'python'} and all(report.get(k)==v for k,v in expected.items()) and type(report['python']) is str and len(report['python'])<=32):raise ValueError('REMOTE_RESULT_INVALID')
        if process.returncode or source_hashes()!=pins:raise ValueError('SOURCE_CHANGED')
        result.update(status='pass',sha256=report['sha256'],files=report['files'],python=report['python'])
        (run/'installer.log').write_text(json.dumps(report)+'\n')
    except (OSError,ValueError,RuntimeError,KeyError,subprocess.SubprocessError):
        result['error']='HELPER_BUNDLE_INSTALL_FAILED';(run/'installer.log').write_text(json.dumps(dict(status='fail',error=result['error']))+'\n')
    (run/'result.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result));return 0 if result['status']=='pass' else 1


if __name__=='__main__':raise SystemExit(main())
