{
  "schema":1,
  "kind":"curved-workspace-design-lifecycle",
  "note":"Pure-model expectations. No SDK/process/disk success is asserted by these synthetic observations. Each trace starts from a fresh world.",
  "base":{
    "operation":"100","next_geometry_revision":"1","input_epoch_before":7,
    "targets":{
      "C":{"session":"2","window":"10","scene":"3","generation":"4"},
      "R":{"session":"2","window":"11","scene":"3","generation":"5"},
      "L":{"session":"2","window":"12","scene":"3","generation":"6"}
    },
    "scope_valid":true,"geometry_unchanged":true,"visible":true,
    "native_neutral":true,"persistent_unique_placements":true,
    "deadlines_ms":{"quiesce":2000,"apply":5000,"rearm":2000,"restore_total":5000}
  },
  "event_semantics":{
    "begin":"Valid capture and proposal, operation 100. Revision becomes 1 and input epoch 8.",
    "all":"Expand to C,R,L full TargetKeys in one observation tick; not a product ACK API.",
    "quiesced":"Adapter-neutral observation for the stated revision and targets.",
    "applied":"Exact desired pose/size and sufficient same-target frame for the stated revision and targets.",
    "input_ready":"New listener preparation for exact revision and input_epoch. Native gate remains closed until every member is ready.",
    "sdk_failure":"Actual failure observation in this synthetic model; first_failure latches.",
    "tick":"Advance only the monotonic clock with unchanged world.",
    "retired":"All native targets and SDK binding resources for the given captured targets have independently completed retirement in the model input.",
    "save_result":"Completion of a previously emitted SaveIntent for operation 100, not an actual filesystem test.",
    "cancel":"Explicit cancel for operation 100 and supplied expected_revision. Completed operations return STALE.",
    "geometry_changed":"Change captured physical/canvas geometry; ordinary content-only frame increments are a separate event.",
    "content_advanced":"Increase content frame without changing physical/logical/canvas geometry. Capture stays valid.",
    "shutdown":"Admission gate must allow the normal shutdown command even when layout is blocked. Does not fabricate cleanup."
  },
  "traces":[
    {
      "id":"S01-normal",
      "events":[
