+impl ShmPoolUserData {
+    /// Create a pool with an accounting guard kept through the deferred unmap/close.
+    /// The guard is dropped on mapping failure, or after the actual mapping and fd.
+    pub fn new_with_drop_guard(
+        fd: std::os::fd::OwnedFd,
+        size: std::num::NonZeroUsize,
+        guard: Box<dyn Send + Sync>,
+    ) -> Result<Self, std::os::fd::OwnedFd> {
+        Pool::new_with_drop_guard(fd, size, guard).map(|inner| Self { inner: Arc::new(inner) })
+    }
+
+    /// Current mapped size, including successful pool resizes.
+    pub fn size(&self) -> usize {
+        self.inner.size()
+    }
+}
