+struct DropGuard(Box<dyn Send + Sync>);
+impl std::fmt::Debug for DropGuard {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let _ = &self.0;
+        f.write_str("DropGuard")
+    }
+}
 
