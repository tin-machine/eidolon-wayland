<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- native固定検査中のCPU休止を防ぐ。通常SDK/実sleep検査やreleaseへは付与しない。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <instrumentation android:name=".NativeCheckInstrumentation"
        android:targetPackage="io.github.tinmachine.eidolon" android:functionalTest="true" />
    <instrumentation android:name=".GpuFdInstrumentation"
        android:targetPackage="io.github.tinmachine.eidolon" android:functionalTest="true" />
    <application>
        <activity android:name=".GpuFdSdkActivity" android:exported="true" android:excludeFromRecents="true" android:launchMode="singleTask"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
        <activity android:name=".DebugCommandActivity" android:exported="true"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay" />
        <receiver android:name=".LinuxSshProbeReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name=".IoWorkloadCommandReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name=".ImeProductCommandReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name=".ImeTerminalCommandReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name=".GtkFixtureCommandReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
